# bbkeys config file, automagically generated by bbconf.
 [begin] (bbkeys configuration file)
   [config]
      [option] (stylefile) {/usr/share/blackbox/styles/AstridIvy}
      [option] (honorModifiers) {false}
      [option] (raiseWhileCycling) {false}
      [option] (showCycleMenu)  {true}
      [option] (cycleMenuTitle)  { Switch Quick!y }
      [option] (menuTextJustify) {center}
      [option] (menuTitleJustify) {center}
      [option] (autoConfig)   {true}
      [option] (autoConfigCheckTimeout) {1}
      [option] (cycleMenuX) {180}
      [option] (cycleMenuY) {180}
   [end]
   [keybindings] (bind some keys please !)
      [execute] (Mod4-M) { xdotool search --name "Wine System Tray" windowactivate }
      # dotkey -- searchable unicode popup, "win-key ." from windows
      [execute] (Mod4-period) { dotkey }
      [NextWindow]  (Mod1-Tab)
      [PrevWindow]  (Mod1-Shift-Tab)
      [NextWindowOnAllWorkspaces]  (Mod4-Tab)
      [NextWorkspace] (Mod4-Prior)
      [PrevWorkspace] (Mod4-Next)
      #[execute] (Mod4-Left)  { xdotool getactivewindow windowmove --relative  4 y }
      #[execute] (Mod4-Right) { xdotool getactivewindow windowmove --relative -4 y }
      #[execute] (Mod4-Up)    { xdotool getactivewindow windowmove --relative x -4 }
      #[execute] (Mod4-Down)  { xdotool getactivewindow windowmove --relative x  4 }
      # begin WORKSPACE SHORTCUT CHAINS
      [Chain] (Mod4-W)
        [cancelChain] (Escape)
        [NextWorkspace] (W)
        [PrevWorkspace] (S)
        [execute] (J) { xdotool search --name "Wine System Tray" windowfocus }
        [ChangeWorkspace] (H)         {1}
        [ChangeWorkspace] (1)         {1}
        [ChangeWorkspace] (Shift-W)   {2}
        [ChangeWorkspace] (2)         {2}
        [ChangeWorkspace] (X)         {3}
        [ChangeWorkspace] (Shift-X)   {3}
        [ChangeWorkspace] (3)         {3}
        [ChangeWorkspace] (L)         {4}
        [ChangeWorkspace] (4)         {4}
        [ChangeWorkspace] (Shift-H)   {5}
        [ChangeWorkspace] (5)         {5}
        [ChangeWorkspace] (Control-H) {6}
        [ChangeWorkspace] (6)         {6}
        [ChangeWorkspace] (Shift-V)   {7}
        [ChangeWorkspace] (7)         {7}
        [ChangeWorkspace] (Shift-E)   {8}
        [ChangeWorkspace] (8)         {8}
        [execute] (Control-A)         { xdotool getactivewindow windowstate --toggle STICKY  }
        [ToggleDecorations] (Control-D)
        [execute] (Control-M)         { xdotool getactivewindow windowstate --toggle MAXIMIZED_HORZ windowstate --toggle MAXIMIZED_VERT }
        [execute] (M)                 { xdotool getactivewindow windowminimize }
        [execute] (Shift-S)         { xdotool getactivewindow windowstate --toggle SHADED }
        [Chain] (T)
          [cancelChain] (Escape)
          [execute] (H) {xdotool getactivewindow set_desktop_for_window 0}
          [execute] (W) {xdotool getactivewindow set_desktop_for_window 1}
          [execute] (X) {xdotool getactivewindow set_desktop_for_window 2}
          [execute] (L) {xdotool getactivewindow set_desktop_for_window 3}
          [execute] (Shift-H) {xdotool getactivewindow set_desktop_for_window 4}
          [execute] (Control-H) {xdotool getactivewindow set_desktop_for_window 5}
          [execute] (V) {xdotool getactivewindow set_desktop_for_window 6}
          [execute] (E) {xdotool getactivewindow set_desktop_for_window 7}
        [end]
        [Chain] (Control-T)
          [cancelChain] (Escape)
          [execute] (H)         { xdotool getactivewindow set_desktop_for_window 0 set_desktop 0 windowactivate }
          [execute] (W)         { xdotool getactivewindow set_desktop_for_window 1 set_desktop 1 windowactivate }
          [execute] (X)         { xdotool getactivewindow set_desktop_for_window 2 set_desktop 2 windowactivate }
          [execute] (L)         { xdotool getactivewindow set_desktop_for_window 3 set_desktop 3 windowactivate }
          [execute] (Shift-H)   { xdotool getactivewindow set_desktop_for_window 4 set_destkop 4 windowactivate }
          [execute] (Control-H) { xdotool getactivewindow set_desktop_for_window 5 set_desktop 5 windowactivate }
          [execute] (V)         { xdotool getactivewindow set_desktop_for_window 6 set_desktop 6 windowactivate }
          [execute] (E)         { xdotool getactivewindow set_desktop_for_window 7 set_desktop 7 windowactivate }
        [end]
      # end WORKSPACE CHAINS
      [end]
      # begin FILE SHORTCUT CHAINS
      [Chain] (Mod4-F)
        [cancelChain] (Escape)
        [execute] (Shift-A) { thunar ~/mus/Astrid\ Ivy\ \* }
        [execute] (slash) { thunar / }
        [execute] (a) { thunar ~ }
        [chain] (d)
          [cancelChain] (Escape)
          [chain] (o)
            [cancelChain] (Escape)
            [chain] (w)
              [cancelChain] (Escape)
              [execute] (n) {thunar ~/doc/download}
            [end]
            [execute] (c) {thunar ~/doc}
          [end]
          [execute]  (l) {thunar /mnt/datao/dl}
          [execute]  (a) {thunar /mnt/datao }
        [end]
        [chain] (p)
          [cancelChain] (Escape)
          [execute]  (c) {thunar ~/.pc}
        [end]
        [chain] (s)
          [cancelChain] (Escape)
          [chain] (e)
            [cancelChain] (Escape)
            [execute] (x) { thunar ~/doc/download/.pr0n }
            [chain] (l)
              [cancelChain] (Escape)
              [execute] (f) { thunar ~/doc/download/iCloud\ Photos }
            [end]
          [end]
        [end]
      # end FILE CHAINS
      [end]
      # begin QUICK-To CHAIN
      [chain] (Mod4-Q)
        [cancelChain] (Escape)
        [execute] (Shift-A) { xdotool search --class Ardour$ windowactivate }
        [execute] (Control-A) { xdotool search --class Alacritty windowactivate }
        [execute] (C) { xdotool search --classname "Google-chrome" windowactivate %@ }
        [execute] (Shift-C) { xdotool search carla2-single-client windowactivate %4 }
        [execute] (Shift-D) { xdotool search --class Discord windowactivate }
        [execute] (Shift-G) { xdotool search --name ^Graph windowactivate }
        [execute] (Shift-H) { xdotool search --name "Hydrogen ..." windowactivate }
        [execute] (Shift-L) { xdotool search --classname carla-bridge-win64.exe windowactivate %4 }
        [execute] (Shift-M) { xdotool search --classname ^Minecraft  windowactivate %@ }
        [execute] (T) { xdotool search --onlyvisible --class thunar windowactivate }
        [execute] (Shift-T) { xdotool search --class thunar windowactivate %@ }
        [execute] (Control-T) { xdotool search --name Twitter windowactivate %@ }
        [execute] (V) { xdotool search --name vim windowactivate }
        [execute] (Shift-V) { xdotool search --name vim windowactivate }
        [execute] (Control-V) { xdotool search --name ^volume windowactivate }
        [execute] (W) { xdotool search --classname "Google-chrome" windowactivate %@ }
        [execute] (X) { xdotool search --onlyvisible --name astrid.ivy windowactivate }
        [execute] (Shift-X) { xdotool search --name astrid.ivy windowactivate }
      # end QUICK CHAIN
      [end]
      # begin e-X-ECUTE CHAIN
      [chain] (Mod4-X)
        [execute] (period) { dotkey }
        [cancelChain] (Escape)
        [execute] (A) { ardour9 }
        [execute] (B) { xterm -geometry 18x1 -e watch -n 1 -w -t -c -d -x batt }
        [execute] (Control-C) { xterm -geometry 60x11 -e tty-clock -s -t -c -C 6  }
        [chain] (Control-E)
          [cancelChain] (Escape)
          [chain] (B)
            [cancelChain] (Escape)
            [execute] (B) { vimtim ~/.blackboxrc }
            [execute] (K) { vimtim ~/.bbkeysrc }
            [execute] (M) { vimtim ~/.blackbox/menu }
          [end]
          [execute] (K) { vimtim ~/.config/keyledsd.conf }
          [execute] (V) { vimtim ~/.vimrc }
        [end]
        [execute] (H) { hydrogen }
        [execute] (Control-J) { maeusic }
        [execute] (Mod4-K) { keyleds_toggle }
        [chain] (M)
          [cancelChain] (Escape)
          [execute] (2) { meters111 }
          [execute] (s) { meters }
          [execute] (o) { cadence-jackmeter }
          [execute] (i) { cadence-jackmeter -in }
        [end]
        [execute] (Mod4-M) { mouse-control.exe }
        [execute] (Q) { qjackctl }
        [execute] (Control-T) { watempo }
        [execute] (V) { vimtim }
        [execute] (Control-V) { volumectl }
        [execute] (W) { google-chrome-stable }
        [execute] (X) { xterm }
        [execute] (Y) { alacritty }
        [execute] (Z) { alacritty --config-file ~/.config/alacritty/xlarge.toml  }
      # end e-X-ECUTE CHAIN
      [end]
   [end]
 [end] (END OF CONFIGURATION)
