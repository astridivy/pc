#!/usr/bin/env python3
#
# commandod -- the commando daemon
#
# "win-key slash": a searchable command runner bound to Mod4-slash, sibling to
# dotkey and built to the same shape. It exists to retire the right-click
# menu's Alacritty entry, whose whole problem was that it left a terminal
# window behind that had to be closed by hand an hour later.
#
# Named for what it does not wear. TODO.md's front-runner was "Command
# Presence"; "Commander" was the other candidate and is thoroughly spoken for
# -- Midnight Commander, Norton, Total Commander, and npm's argument parser.
#
# THE ONE IDEA. A command does not get a window of its own. It gets a *screen
# window* inside a session you already have open -- so there is nothing new to
# close, and everything you ran is still there under C-a " if you want it back.
# Which session, in order:
#
#     c      a `claude <dir>` session for some dir other than ~   (you typed c)
#     v      a `vim <files>` session                              (you typed v)
#     cclod  `claude ~`                              (the menu's claude-code)
#     vvim   `vim`, bare                             (the menu's vim)
#     run    commando's own session, made only if none of the above exist
#
# That order is the entire point and is not a heuristic to be improved: it is
# where Astrid expects the thing to land. `c` and `cclod` both produce sessions
# named `claude <dir>` -- screenclaude names them after the cwd -- and the menu
# always hands its children $HOME, so `claude ~` is the menu's and anything
# else was typed. Same trick separates `v` from `vvim`: screenvim names a bare
# vim just "vim" and a vim-with-files "vim <paths>". See bashrc/screen.
#
# The landing may well be INVISIBLE -- the session can be detached, or on
# another workspace. That is understood and wanted. A new window in a detached
# session costs nothing and is still there later; a new alacritty costs a
# cleanup pass.
#
# GUI apps skip all of it and are simply launched. Wrapping thunar in a screen
# window would be worse than useless -- the window it opens is the app, and the
# screen window would sit there empty forever waiting for it to exit.
#
# WHERE THE SUGGESTIONS COME FROM, best first:
#
#     ~/bin/shortcuts                  curated, hand-written, always wins
#     ~/.blackbox/menu                 every [exec] (label) {command}
#     */applications/*.desktop         Name= and Exec=, three directories
#     history                          whatever you have run through here
#
# ...and whatever you typed is always offered verbatim as the last row, so the
# thing is never *only* a launcher.
#
# WHY A DAEMON: the same reason dotkeyd is one, measured on this box --
# `import gi` + Gtk 3.24 is 1.64s before a single pixel lands. Rendering was
# never the problem, process startup was. Read dotkeyd's header for the full
# table, and CLAUDE.md's dotkey section for the five X11 traps this file
# inherits wholesale: owner_events=False, grab SeatCapabilities.ALL rather than
# keyboard-only, tear the window down if the grab fails, retry the grab because
# the hotkey's own modifier is still holding it, and monotonic for the deadline.
#
# astrid + claude
# 2026-08-07

import os
import re
import sys
import glob
import stat
import time
import json
import shlex
import subprocess

CACHE_DIR = os.path.expanduser("~/.cache/commando")
RECENT_PATH = os.path.join(CACHE_DIR, "recent.json")

SHORTCUTS_PATH = os.path.expanduser("~/bin/shortcuts")
MENU_PATH = os.path.expanduser("~/.blackbox/menu")
# Three, deliberately. The repo copy is the source-controlled one and the one
# worth curating; the live ~/.local copy is where wine, steam and chrome drop
# theirs unasked; /usr/share is everything a package installed. All three are
# read so a launcher entry can come from any of them, and the repo copy sorts
# first when two of them describe the same command.
DESKTOP_DIRS = [
    os.path.expanduser("~/src/pc/.local/share/applications"),
    os.path.expanduser("~/.local/share/applications"),
    "/usr/share/applications",
]

RUNTIME_DIR = os.environ.get("XDG_RUNTIME_DIR") or "/run/user/%d" % os.getuid()
FIFO_PATH = os.path.join(RUNTIME_DIR, "commando.fifo")
# A pidfile, not a pgrep. `pgrep -f commandod` also matches any shell whose own
# command line mentions commandod -- including the one asking the question --
# so a "is it running?" check can kill the asker or answer yes about itself.
PID_PATH = os.path.join(RUNTIME_DIR, "commando.pid")
# Scripts handed to screen. See run_script() for why these are files on disk
# and not arguments: `screen -X` re-parses its arguments, and a path is one
# word with nothing in it to re-parse.
SPOOL_DIR = os.path.join(RUNTIME_DIR, "commando")

BASHRC = os.environ.get("BASHRC") or os.path.expanduser("~/src/bashrc")

# The screen session commando makes for itself when there is nothing else to
# land in. Fixed name, so the second throwaway command joins the first one
# instead of opening a second alacritty -- which is the exact failure this
# whole program exists to delete.
OWN_SESSION = "run"

MAX_ROWS = 12          # rows drawn; also the ranking cutoff
WIN_W = 760
MAX_RECENT = 60

# How long to keep asking for the input grab before giving up, and how often.
# We are launched from a hotkey, so the modifier that launched us is still down
# when we try to grab, and attempt one reliably fails. See show().
GRAB_TIMEOUT = 1.0
GRAB_RETRY = 0.01

# palette lifted from .config/alacritty/alacritty.toml, same as dotkeyd, so the
# two popups are visibly the same family of thing.
C_BG = "#010116"
C_FG = "#ffb1f3"
C_DIM = "#604070"
C_SEL = "#fc74f4"
C_ACCENT = "#69ffb0"
C_QUERY = "#ffff66"

UI_FONT = "Misc Tamsyn"

DEBUG = bool(os.environ.get("COMMANDO_DEBUG"))

# Anything whose argv already contains one of these brings its own window, so
# it must never be wrapped in a screen window as well -- you would get an
# alacritty inside a screen window inside an alacritty. bin/vvim and bin/cclod
# are exactly this case and are detected by reading them, see guess_mode().
TERMINALS = ("alacritty", "xterm", "uxterm", "urxvt", "kitty", "st",
             "konsole", "gnome-terminal", "xfce4-terminal", "terminator")

# The same names, for searching the *text* of a shell script rather than an
# argv. It has to be anchored on word boundaries: `st` is a real terminal and
# also a substring of "install", "system" and "just", so a plain `in` test
# reports essentially every script on the box as bringing its own window. That
# failure is invisible -- it produces a confident wrong answer, not an error --
# and it classified bin/dotkey, bin/screenshot and /usr/bin/discord as GUI apps
# purely on coincidental letters.
TERM_WORD = re.compile(r"(?<![\w-])(%s)(?![\w-])"
                       % "|".join(re.escape(t) for t in TERMINALS))

# Shared libraries that only a program drawing its own window links against.
# Cheaper and far more honest than a hardcoded list of app names, which would
# be wrong the moment anything new is installed.
GUI_LIBS = ("libX11", "libgtk", "libQt", "libwayland", "libSDL", "libEGL")

# XDG desktop-entry field codes. They expand to the files or urls being opened,
# and there are none of those here, so they have to come out or you get a
# literal "%U" as an argument.
FIELD_CODES = re.compile(r"%[fFuUdDnNickvm]")

SOURCE_BONUS = {
    "shortcut": -400,
    "history": -350,
    "menu": -250,
    "desktop": -100,
}


def log(msg):
    sys.stderr.write("commandod: %s\n" % msg)


def read_pidfile():
    """PID of a live daemon, or None. Stale pidfiles are treated as absent."""
    try:
        with open(PID_PATH) as fh:
            pid = int(fh.read().strip())
    except (OSError, ValueError):
        return None
    try:
        os.kill(pid, 0)
    except OSError:
        return None
    return pid


# --------------------------------------------------------------- the sources

class Entry:
    """One runnable thing: what to call it, what to run, and how to run it.

    `mode` is "term", "gui" or "" -- empty meaning nobody said, so guess_mode()
    will work it out at launch time rather than now. Guessing costs an ldd and
    there is no reason to spend it on 400 entries to launch one.
    """

    __slots__ = ("label", "cmd", "source", "mode", "hold", "demoted", "key")

    def __init__(self, label, cmd, source, mode="", hold=False, demoted=False):
        self.label = label
        self.cmd = cmd
        self.source = source
        self.mode = mode
        self.hold = hold
        self.demoted = demoted
        self.key = cmd.strip()


def parse_shortcuts(path):
    """~/bin/shortcuts -- the curated list, and the only one Astrid writes.

        label            command                       @flags

    Fields are separated by a run of TWO OR MORE spaces, or by tabs. That is
    deliberate and is not the usual single-tab convention: .vimrc sets
    expandtab globally, so a Tab typed into a tab-delimited file silently
    becomes spaces and the line silently stops parsing -- the trap documented
    against .config/dotkey/custom.tsv in CLAUDE.md. Accepting both means the
    file cannot be broken by the editor that edits it.

    Flags, any order, all optional:
        @gui    never wrap in a screen window; just launch it
        @term   always wrap, even if it looks like a GUI app
        @hold   keep the screen window open after the command exits
    """
    out = []
    try:
        with open(path, encoding="utf-8") as fh:
            for line in fh:
                line = line.rstrip("\n")
                if not line.strip() or line.lstrip().startswith("#"):
                    continue
                parts = [p for p in re.split(r"\t+| {2,}", line.strip()) if p]
                if len(parts) < 2:
                    continue
                flags = {p.lower() for p in parts[2:] if p.startswith("@")}
                mode = "gui" if "@gui" in flags else "term" if "@term" in flags else ""
                out.append(Entry(parts[0], parts[1], "shortcut",
                                 mode=mode, hold="@hold" in flags))
    except FileNotFoundError:
        pass
    return out


# [exec] (label) {command} -- the only menu line that runs anything. [submenu]
# has the same shape but its braces hold a *title*, not a command, so matching
# the tag name rather than the shape is what keeps them out.
MENU_EXEC = re.compile(r"^\s*\[exec\]\s*\(([^)]*)\)\s*\{(.*)\}\s*$", re.I)


def parse_menu(path):
    """~/.blackbox/menu -- every [exec] entry, label and command both.

    Commented-out entries are skipped; the menu keeps a few of those as notes
    about the other machine, and offering them would launch things that cannot
    work here.
    """
    out = []
    try:
        with open(path, encoding="utf-8") as fh:
            for line in fh:
                if line.lstrip().startswith("#"):
                    continue
                m = MENU_EXEC.match(line)
                if not m:
                    continue
                label = m.group(1).strip().strip('"').strip()
                cmd = m.group(2).strip()
                if not cmd:
                    continue
                out.append(Entry(label or cmd, cmd, "menu"))
    except FileNotFoundError:
        pass
    return out


def parse_desktop(path):
    """One .desktop file -> an Entry, or None if it is not a launchable app.

    Only the [Desktop Entry] group is read. Actions and mime groups further
    down have their own Name=/Exec= pairs, and folding those in gives several
    entries all claiming to be the same app.
    """
    fields = {}
    try:
        with open(path, encoding="utf-8", errors="replace") as fh:
            in_main = False
            for line in fh:
                line = line.strip()
                if line.startswith("["):
                    if in_main:
                        break
                    in_main = line.lower() == "[desktop entry]"
                    continue
                if not in_main or "=" not in line or line.startswith("#"):
                    continue
                k, _, v = line.partition("=")
                fields.setdefault(k.strip(), v.strip())
    except OSError:
        return None

    if fields.get("Type", "Application") != "Application":
        return None
    exec_ = fields.get("Exec", "").strip()
    if not exec_:
        return None

    cmd = FIELD_CODES.sub("", exec_).strip()
    # Name= is frequently quoted in the files here ("feh (sensible)"), which is
    # not part of the spec but is what is on disk.
    label = fields.get("Name", "").strip().strip('"').strip() or os.path.basename(path)

    # Terminal= is the authoritative answer to the question guess_mode() has to
    # work for on everything else, so take it when it is offered.
    term = fields.get("Terminal", "false").strip().lower() in ("true", "1")

    # NoDisplay/Hidden mean "not a menu entry" -- here they are almost all mime
    # handlers (feh, xwud). Kept, because typing `feh` and getting it is right,
    # but demoted so they never crowd out something you meant.
    demoted = (fields.get("NoDisplay", "").lower() in ("true", "1")
               or fields.get("Hidden", "").lower() in ("true", "1"))

    return Entry(label, cmd, "desktop", mode="term" if term else "gui",
                 demoted=demoted)


def build_desktop_modes(entries):
    """program basename -> "gui"/"term", from every .desktop file's Terminal=.

    The first entry to claim a name keeps it, and the directories are read
    best-first, so a curated repo copy outranks whatever wine wrote last week.
    """
    modes = {}
    for e in entries:
        if e.source != "desktop" or not e.mode:
            continue
        prog = os.path.basename(real_prog(split_cmd(e.cmd)))
        if prog and prog not in modes:
            modes[prog] = e.mode
    return modes


def parse_desktop_dirs(dirs):
    out = []
    for d in dirs:
        for path in sorted(glob.glob(os.path.join(d, "*.desktop"))):
            e = parse_desktop(path)
            if e is not None:
                out.append(e)
    return out


# ----------------------------------------------------------------- the index

class Index:
    """Every entry from every source, plus history, reloaded when files move.

    Sources are re-stat'd on each popup rather than watched. The whole parse is
    a couple of hundred small files and lands in single-digit milliseconds --
    far under the threshold where anyone would notice -- and it means editing
    .blackbox/menu or ~/bin/shortcuts is live on the next Mod4-slash, matching
    how the click menu already behaves.
    """

    def __init__(self):
        self.entries = []
        self._stamp = None
        self.recent = self._load_recent()
        self.reload()

    # -- sources ---------------------------------------------------------

    def _sources_stamp(self):
        stamp = []
        for path in [SHORTCUTS_PATH, MENU_PATH] + DESKTOP_DIRS:
            try:
                st = os.stat(path)
                stamp.append((path, st.st_mtime, st.st_size))
            except OSError:
                stamp.append((path, 0, 0))
        return tuple(stamp)

    def maybe_reload(self):
        if self._sources_stamp() != self._stamp:
            self.reload()

    def reload(self):
        t0 = time.time()
        self._stamp = self._sources_stamp()
        entries = (parse_shortcuts(SHORTCUTS_PATH)
                   + parse_menu(MENU_PATH)
                   + parse_desktop_dirs(DESKTOP_DIRS))

        # Dedupe on the command, keeping the first -- and the sources are
        # concatenated best-first, so "the first" is "the one from the most
        # authoritative file". A command in ~/bin/shortcuts therefore keeps the
        # label Astrid gave it rather than picking up a .desktop's Name=.
        seen = set()
        self.entries = []
        for e in entries:
            if e.key in seen:
                continue
            seen.add(e.key)
            self.entries.append(e)

        self.lower = [(e.label.lower(), e.cmd.lower()) for e in self.entries]
        self._known = seen

        # Harvest Terminal= into the lookup guess_mode() consults. Built from
        # the pre-dedupe list on purpose: a .desktop entry that lost the dedupe
        # to a ~/bin/shortcuts line still knows whether its program draws a
        # window, and that is the only thing being taken from it here.
        global _desktop_modes, _mode_cache
        _desktop_modes = build_desktop_modes(entries)
        _mode_cache = {}          # the lookup changed, so old guesses are stale

        log("%d entries in %.0f ms" % (len(self.entries), (time.time() - t0) * 1000))

    # -- history ---------------------------------------------------------

    def _load_recent(self):
        try:
            with open(RECENT_PATH, encoding="utf-8") as fh:
                data = json.load(fh)
            return {k: float(v) for k, v in data.items()}
        except (OSError, ValueError, AttributeError):
            return {}

    def bump(self, cmd):
        self.recent[cmd] = self.recent.get(cmd, 0.0) + 1.0
        if len(self.recent) > MAX_RECENT:
            for k in sorted(self.recent, key=self.recent.get)[:-MAX_RECENT]:
                del self.recent[k]
        try:
            os.makedirs(CACHE_DIR, exist_ok=True)
            tmp = RECENT_PATH + ".tmp"
            with open(tmp, "w", encoding="utf-8") as fh:
                json.dump(self.recent, fh)
            os.replace(tmp, RECENT_PATH)
        except OSError:
            pass

    def history_entries(self):
        """Past one-liners that no source already offers.

        This is the system-wide command history the click menu never had: it is
        not tied to whichever terminal happened to have focus, because it was
        never typed into a terminal in the first place.
        """
        return [Entry(c, c, "history")
                for c in sorted(self.recent, key=self.recent.get, reverse=True)
                if c not in self._known]

    # -- search ----------------------------------------------------------

    @staticmethod
    def _score_in(hay, tok):
        """Cost of finding tok in hay, or None. Lower is a better match."""
        pos = hay.find(tok)
        if pos < 0:
            return None
        if hay == tok:
            return 0
        if pos == 0:
            return 10
        if hay[pos - 1] in " -_/.":
            return 20        # word-initial
        return 40            # buried mid-word

    def search(self, q):
        q = q.strip()
        pool = self.entries + self.history_entries()

        if not q:
            # The default view is the one *every* popup draws, so it must not
            # do any work worth measuring: most-used first, then the curated
            # file in the order it was written.
            rows = [e for e in pool if e.cmd in self.recent]
            rows.sort(key=lambda e: -self.recent.get(e.cmd, 0))
            for e in pool:
                if e.cmd not in self.recent and e.source == "shortcut":
                    rows.append(e)
            return rows[:MAX_ROWS]

        toks = q.lower().split()
        scored = []
        for i, e in enumerate(pool):
            lab, cmd = (self.lower[i] if i < len(self.lower)
                        else (e.label.lower(), e.cmd.lower()))
            total = 0
            for t in toks:
                sl = self._score_in(lab, t)
                sc = self._score_in(cmd, t)
                # Matching the label is worth more than matching the command:
                # "Volume Mixer" should beat some other entry that merely
                # mentions volumectl in its arguments.
                if sl is None and sc is None:
                    break
                total += min(sl if sl is not None else 999,
                             (sc if sc is not None else 999) + 15)
            else:
                total += SOURCE_BONUS.get(e.source, 0)
                if e.demoted:
                    total += 300
                total -= min(self.recent.get(e.cmd, 0.0), 8.0) * 15
                total += len(e.label) * 0.01      # prefer the tersest label
                scored.append((total, i, e))

        scored.sort(key=lambda s: (s[0], s[1]))
        return [e for _, _, e in scored[:MAX_ROWS]]


# --------------------------------------------------------------- how to run

_mode_cache = {}

# program basename -> "gui"/"term", harvested from every .desktop file's
# Terminal= field. Populated by Index.reload(); empty in the --mode CLI, which
# builds it on demand. See guess_mode() for why this outranks everything else.
_desktop_modes = {}


def split_cmd(cmd):
    """argv for a command line, tolerant of quoting nobody closed."""
    try:
        return shlex.split(cmd)
    except ValueError:
        return cmd.split()


def real_prog(argv):
    """The program in argv that actually decides anything.

    `env FOO=bar realcmd ...` and bare `FOO=bar realcmd` are wrappers -- every
    wine entry in .local/share/applications is the first shape -- and asking
    whether /usr/bin/env draws a window is asking the wrong binary.
    """
    head = 0
    while head < len(argv) and (argv[head] == "env" or "=" in argv[head]):
        head += 1
    if head < len(argv):
        return argv[head]
    return argv[0] if argv else ""


def guess_mode(cmd):
    """"term" or "gui" for a command nobody classified.

    The question is only ever "does this draw its own window?", answered in
    descending order of how much the answer can be trusted:

      1. it names a terminal emulator, so it brings its own window already
      2. some .desktop file declares it, and Terminal= is the one place on the
         system where a human wrote the answer down on purpose
      3. it is an ELF that links libX11/libgtk/libQt
      4. it is a script that execs a terminal emulator

    3 is the honest general test and 2 exists because it is not general enough:
    chrome, discord and half of /usr/bin are *shell script wrappers* around the
    real binary, so they link nothing at all and would otherwise all come back
    "term" -- a wrong answer with no symptom except your browser appearing in a
    screen window. Anything still unclassified is "term", which is the right
    default for a box whose ~/bin is entirely terminal tools.
    """
    if cmd in _mode_cache:
        return _mode_cache[cmd]

    argv = split_cmd(cmd)
    mode = "term"

    # 1. `xterm -e ...`, and every launcher in ~/bin. Exact basenames, never
    #    substrings -- see TERM_WORD.
    if {os.path.basename(a) for a in argv} & set(TERMINALS):
        mode = "gui"
    else:
        prog = os.path.basename(real_prog(argv))
        if prog in _desktop_modes:
            mode = _desktop_modes[prog]          # 2
        else:
            path = _which(prog)
            if path:
                mode = _mode_of_file(path)       # 3, 4

    _mode_cache[cmd] = mode
    return mode


def _which(prog):
    if not prog:
        return None
    if "/" in prog:
        return prog if os.path.exists(prog) else None
    for d in (os.environ.get("PATH") or "").split(os.pathsep):
        p = os.path.join(d, prog)
        if os.path.isfile(p) and os.access(p, os.X_OK):
            return p
    return None


def _mode_of_file(path):
    try:
        with open(path, "rb") as fh:
            head = fh.read(4096)
    except OSError:
        return "term"

    if not head.startswith(b"\x7fELF"):
        # A script. It cannot link anything, so ask what it *runs*: the ~/bin
        # launchers all exec an alacritty, and that is exactly the case that
        # must not be wrapped again. Word-anchored, or "st" matches "install".
        text = head.decode("utf-8", "replace")
        return "gui" if TERM_WORD.search(text) else "term"

    try:
        out = subprocess.run(["ldd", path], capture_output=True, text=True,
                             timeout=3).stdout
    except (OSError, subprocess.SubprocessError):
        return "term"
    return "gui" if any(lib in out for lib in GUI_LIBS) else "term"


# ------------------------------------------------------------- screen wrangling

# Rank of each session shape, best first. See the header: this order is a
# statement about where Astrid expects things to land, not a heuristic.
RANK_C, RANK_V, RANK_CCLOD, RANK_VVIM, RANK_OWN = range(5)


def session_rank(name):
    """Which of the five landing spots this session is, or None for neither.

    Deliberately narrow. A `google cat pictures` session from `g` is a real
    screen session and is still not somewhere a command should silently appear,
    so it is not a target -- predictability is the whole feature.
    """
    if name == OWN_SESSION:
        return RANK_OWN
    if name.startswith("claude "):
        return RANK_CCLOD if name == "claude ~" else RANK_C
    if name == "vim":
        return RANK_VVIM
    if name.startswith("vim "):
        return RANK_V
    return None


def list_sessions():
    """[(rank, attached, pid, full, name)] for every session worth landing in.

    `screen -ls` prints one tab-indented line per session as "PID.NAME", and
    screen's own name matching is fuzzy -- `-S vim` would happily select
    `vim foo` -- so the full "PID.NAME" string is what gets handed back to
    screen later. That form is exact.
    """
    try:
        out = subprocess.run(["screen", "-ls"], capture_output=True, text=True,
                             timeout=5).stdout
    except (OSError, subprocess.SubprocessError):
        return []

    found = []
    for line in out.splitlines():
        if not line.startswith("\t"):
            continue
        parts = line.strip().split("\t")
        if not parts:
            continue
        full = parts[0].strip()
        dot = full.find(".")        # a pid never contains one, so the first wins
        if dot < 1:
            continue
        pid, name = full[:dot], full[dot + 1:]
        if not pid.isdigit():
            continue
        rank = session_rank(name)
        if rank is None:
            continue
        attached = "attached" in line.lower()
        found.append((rank, attached, int(pid), full, name))

    # rank first, because that is the promise. Attached only breaks ties, on
    # the grounds that a landing you can actually see beats one you cannot --
    # but never at the cost of reordering the five.
    found.sort(key=lambda s: (s[0], not s[1], -s[2]))
    return found


def run_script(cmd, title, hold):
    """Write the little shell script that a screen window will run.

    A file, not arguments, and that is the whole trick. `screen -X` re-parses
    the arguments it forwards, so a command containing quotes, newlines or
    backslashes -- which any interesting one-liner does -- cannot be passed
    through it intact. A path is a single word with nothing in it to re-parse,
    and everything gnarly lives inside the file where no one else looks at it.

    The command arrives as "$1" rather than being pasted into the script text,
    for the reason CLAUDE.md gives about alacritty -e: pasting it in means
    anything quoted stops being quoted.

    bashrc is sourced so that `v`, `c`, `g` and the rest work here exactly as
    they do in a terminal -- but `danger` is NOT, because that is the file that
    exists to keep sudo-prepending aliases away from shells with nobody sitting
    at them, and this shell is started by a keypress.
    """
    # 0700: these files hold whatever command was typed.
    os.makedirs(SPOOL_DIR, mode=0o700, exist_ok=True)
    path = os.path.join(SPOOL_DIR, "run-%d-%d.sh" % (os.getpid(), int(time.time() * 1000)))
    body = r'''#!/bin/bash
# written by commandod; deletes itself on the way out
BASHRC="$1" ; CMD="$2" ; TITLE="$3" ; HOLD="$4" ; SELF="$0"

# name the screen window from in here, so the title never has to survive
# `screen -X` argument parsing either
printf '\033k%s\033\\' "$TITLE"

shopt -s expand_aliases

# Keep the PATH we were handed. bashrc/exports rebuilds it through
# ~/bin/setadd, and setadd is truncated mid-string -- it emits a syntax error
# and echoes "$HOME/bin" alone, so sourcing exports leaves a PATH with no
# /usr/bin in it and `sleep` stops existing. screen inherited a real login
# shell's PATH, which is the better one anyway. Drop the save/restore once
# setadd is fixed; see TODO.md.
# stderr is dropped because setadd fails loudly: three syntax errors and a
# "can only return from a function" land in the pane ahead of any real output,
# on every single command. Restore the redirect once setadd is fixed -- errors
# from sourcing bashrc are worth seeing, these just aren't news.
_PATH="$PATH"
for f in exports functions screen aliases shortcuts ; do
  [ -r "$BASHRC/$f" ] && source "$BASHRC/$f"
done 2>/dev/null
PATH="$_PATH"
for d in "$HOME/bin" "$HOME/.npm/packages/bin" ; do
  case ":$PATH:" in *":$d:"*) ;; *) PATH="$d:$PATH" ;; esac
done
export PATH

cd "$HOME" || exit 1
eval "$CMD"
RC=$?

# Hold the window open only when there is something to read: a command that
# worked closes its window and leaves nothing to tidy, which is the entire
# point of this program. A failure keeps its message on screen.
if [ "$HOLD" = 1 ] || [ "$RC" -ne 0 ] ; then
  printf '\n\033[35m[commando]\033[0m %s \033[35mexit %s\033[0m\n' "$CMD" "$RC"
  read -rsn1 -p '[any key]'
fi
rm -f "$SELF"
'''
    with open(path, "w", encoding="utf-8") as fh:
        fh.write(body)
    os.chmod(path, 0o700)
    return path, [path, BASHRC, cmd, title, "1" if hold else "0"]


def sweep_spool():
    """Scripts left behind by anything that died before deleting its own."""
    try:
        now = time.time()
        for p in glob.glob(os.path.join(SPOOL_DIR, "run-*.sh")):
            try:
                if now - os.stat(p).st_mtime > 3600:
                    os.unlink(p)
            except OSError:
                pass
    except OSError:
        pass
    return True


def launch(entry, hold=False):
    """Run it. Returns a short string describing where it went, for the log.

    `hold` is per-invocation and deliberately not written back onto the entry:
    the entries are the index's own objects and live for as long as the daemon
    does, so one ctrl+enter would otherwise make that row hold its window for
    the rest of the session.
    """
    cmd = entry.cmd
    mode = entry.mode or guess_mode(cmd)

    if mode == "gui":
        # setsid, so it outlives this daemon and never becomes its zombie.
        subprocess.Popen(["setsid", "-f", "/bin/sh", "-c", cmd],
                         cwd=os.path.expanduser("~"),
                         stdin=subprocess.DEVNULL,
                         stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL)
        return "gui"

    script, argv = run_script(cmd, entry.label[:40] or cmd[:40], hold or entry.hold)

    sessions = list_sessions()
    if sessions:
        rank, attached, _pid, full, name = sessions[0]

        # Split a new region off rather than taking over the focused one, so
        # what you were already looking at stays on screen next to what you
        # just ran. `split` stacks regions vertically (the C-a S split, not
        # C-a |), matching .screenrc's h/j/k/l motions.
        #
        # Only when attached: a region layout belongs to a *display*, and a
        # detached session has none, so there would be nothing to split and
        # nothing to see. There it just gets a window, which is what it wanted.
        #
        # No cap is needed. screen refuses to split a region that has no room
        # left, so the panes stop subdividing on their own -- and because -X
        # always exits 0 whether the command worked or not, a cap could not be
        # enforced from the return code anyway.
        if attached:
            for sub in (["split"], ["focus", "down"]):
                subprocess.run(["screen", "-S", full, "-X"] + sub,
                               capture_output=True, text=True, timeout=5)

        # `screen -X screen <cmd>` makes a new window and works whether or not
        # anyone is attached. Attached, it appears in the region just focused;
        # detached, it is simply waiting in the window list.
        r = subprocess.run(["screen", "-S", full, "-X", "screen"] + argv,
                           capture_output=True, text=True, timeout=5)
        if r.returncode == 0:
            return "%s in %r (rank %d)" % (
                "split pane" if attached else "screen window", name, rank)
        log("screen -X failed on %r: %s" % (name, r.stderr.strip()))

    # Nothing to land in. Make the one session commando owns, in a terminal of
    # its own -- once. Everything after this lands in it as a window.
    subprocess.Popen(["setsid", "-f", "alacritty",
                      "--config-file", os.path.expanduser("~/.config/alacritty/nearly.toml"),
                      "--title", "commando",
                      "-e", "screen", "-S", OWN_SESSION] + argv,
                     cwd=os.path.expanduser("~"),
                     stdin=subprocess.DEVNULL,
                     stdout=subprocess.DEVNULL,
                     stderr=subprocess.DEVNULL)
    return "new %r session" % OWN_SESSION


# ------------------------------------------------------------- headless CLI

def cli_search(index, query):
    rows = index.search(query)
    if not rows:
        print("(no matches)")
    for e in rows:
        print("%-9s %-28s %s" % (e.source, e.label[:28], e.cmd))
    if query.strip():
        print("%-9s %-28s %s" % ("typed", "", query.strip()))


def cli_where():
    rows = list_sessions()
    if not rows:
        print("no landing session; the next command would open one named %r"
              % OWN_SESSION)
        return
    names = {RANK_C: "c", RANK_V: "v", RANK_CCLOD: "cclod",
             RANK_VVIM: "vvim", RANK_OWN: "run"}
    for i, (rank, attached, pid, _full, name) in enumerate(rows):
        print("%s %-6s %-7s %6d  %s" % ("->" if i == 0 else "  ",
                                        names[rank],
                                        "attached" if attached else "detached",
                                        pid, name))


def main():
    args = sys.argv[1:]

    if args and args[0] in ("-h", "--help"):
        print("usage: commandod [--search QUERY | --where | --mode CMD...]")
        print("  --search  rank the sources for QUERY, no popup, no daemon")
        print("  --where   which screen session the next command would land in")
        print("  --mode    would CMD be wrapped in a screen window, or launched")
        print("            one CMD per argument, so quote anything with spaces")
        return 0

    if args and args[0] == "--where":
        cli_where()
        return 0

    if args and args[0] == "--mode":
        # Only the desktop half of the index matters here, and skipping the
        # rest keeps this answerable without a daemon or an X display.
        global _desktop_modes
        _desktop_modes = build_desktop_modes(parse_desktop_dirs(DESKTOP_DIRS))
        for cmd in (args[1:] or []):
            print("%s\t%s" % (guess_mode(cmd), cmd))
        return 0

    index = Index()

    if args and args[0] == "--search":
        cli_search(index, " ".join(args[1:]))
        return 0

    return run_daemon(index)


# ------------------------------------------------------------------- the ui

def run_daemon(index):
    import gi
    gi.require_version("Gtk", "3.0")
    from gi.repository import Gtk, Gdk, GLib, Pango

    class Popup:
        def __init__(self, index):
            self.index = index
            self.query = ""
            self.rows = []
            self.sel = 0
            self.grabbed = False

            # POPUP is gtk's override-redirect window type. blackbox predates
            # most _NET_WM_* hints, so anything that negotiates with the WM is
            # a gamble here; override-redirect sidesteps it entirely.
            self.win = Gtk.Window(type=Gtk.WindowType.POPUP)
            self.win.set_default_size(WIN_W, 0)
            self.win.set_app_paintable(True)

            frame = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
            frame.set_name("frame")
            self.win.add(frame)

            self.qlabel = Gtk.Label(xalign=0.0)
            self.qlabel.set_name("query")
            self.qlabel.set_ellipsize(Pango.EllipsizeMode.END)
            frame.pack_start(self.qlabel, False, False, 0)

            # Preallocated rows. Rebuilding widgets on every keystroke is the
            # one thing that would make this feel slow on this CPU, so a row's
            # position is fixed for the life of the daemon and only its text
            # and visibility ever change.
            # No column spacing: the three labels in a row are separated by
            # their own padding instead, so the selected row's highlight is one
            # unbroken bar. With spacing the gaps stay unpainted and a selected
            # row reads as three disconnected boxes.
            self.grid = Gtk.Grid()
            self.grid.set_column_spacing(0)
            self.grid.set_row_homogeneous(True)
            frame.pack_start(self.grid, False, False, 0)

            self.labels, self.cmds, self.tags = [], [], []
            for r in range(MAX_ROWS):
                lab = Gtk.Label(xalign=0.0)
                lab.set_name("row")
                lab.set_ellipsize(Pango.EllipsizeMode.END)
                lab.set_max_width_chars(26)
                lab.set_width_chars(26)
                cmd = Gtk.Label(xalign=0.0)
                cmd.set_name("cmd")
                cmd.set_ellipsize(Pango.EllipsizeMode.END)
                # The command column is the one that absorbs the slack, which
                # is what pins the source tag to the right edge instead of
                # leaving it floating in the middle of the row.
                cmd.set_hexpand(True)
                tag = Gtk.Label(xalign=1.0)
                tag.set_name("tag")
                self.grid.attach(lab, 0, r, 1, 1)
                self.grid.attach(cmd, 1, r, 1, 1)
                self.grid.attach(tag, 2, r, 1, 1)
                self.labels.append(lab)
                self.cmds.append(cmd)
                self.tags.append(tag)

            self.hint = Gtk.Label(xalign=0.0)
            self.hint.set_name("hint")
            frame.pack_start(self.hint, False, False, 0)

            self._style()
            self.win.connect("key-press-event", self.on_key)

            # The grab below is owner_events=False, so X reports every pointer
            # event to the grab window -- this toplevel -- and never to a
            # child. Per-row EventBoxes would silently never fire; hit-testing
            # against each row's allocation is what actually works, and it is
            # also the only way to see a click-outside, which arrives here too
            # with coordinates beyond the window.
            self.win.add_events(Gdk.EventMask.BUTTON_PRESS_MASK
                                | Gdk.EventMask.SCROLL_MASK
                                | Gdk.EventMask.POINTER_MOTION_MASK)
            self.win.connect("button-press-event", self.on_click)
            self.win.connect("scroll-event", self.on_scroll)
            self.win.connect("motion-notify-event", self.on_motion)

        def _style(self):
            css = """
            #frame { background-color: %(bg)s; border: 1px solid %(sel)s; }
            #query { color: %(q)s; font-family: "%(font)s"; font-size: 15px;
                     padding: 8px 12px 8px 12px; }
            #row   { color: %(fg)s; font-family: "%(font)s"; font-size: 13px;
                     padding: 2px 0 2px 12px; }
            #cmd   { color: %(dim)s; font-family: "%(font)s"; font-size: 12px;
                     padding: 2px 12px 2px 0; }
            #tag   { color: %(dim)s; font-family: "%(font)s"; font-size: 10px;
                     padding: 2px 12px 2px 0; }
            #row.sel { color: %(acc)s; background-color: %(dim)s; }
            #cmd.sel { color: %(fg)s; background-color: %(dim)s; }
            #tag.sel { color: %(fg)s; background-color: %(dim)s; }
            #hint  { color: %(dim)s; font-family: "%(font)s"; font-size: 10px;
                     padding: 6px 12px 6px 12px; }
            """ % dict(bg=C_BG, fg=C_FG, dim=C_DIM, sel=C_SEL,
                       acc=C_ACCENT, q=C_QUERY, font=UI_FONT)
            prov = Gtk.CssProvider()
            prov.load_from_data(css.encode())
            Gtk.StyleContext.add_provider_for_screen(
                Gdk.Screen.get_default(), prov,
                Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

        # -- painting ----------------------------------------------------

        def _visible_rows(self):
            """Matches, plus whatever was typed offered verbatim at the end.

            The typed row is what keeps this from being merely a launcher: the
            thing a scratch terminal was for is running something that is not
            in any list, and it has to be reachable without leaving the popup.
            """
            rows = list(self.index.search(self.query))
            q = self.query.strip()
            if q and not any(e.cmd == q for e in rows):
                rows = rows[:MAX_ROWS - 1] + [Entry(q, q, "typed")]
            return rows[:MAX_ROWS]

        def refresh(self):
            self.rows = self._visible_rows()
            if self.sel >= len(self.rows):
                self.sel = max(0, len(self.rows) - 1)

            self.qlabel.set_text("/" + self.query + "█")

            for i in range(MAX_ROWS):
                if i < len(self.rows):
                    e = self.rows[i]
                    self.labels[i].set_text(e.label)
                    self.cmds[i].set_text(e.cmd if e.cmd != e.label else "")
                    self.tags[i].set_text(e.source)
                    for w in (self.labels[i], self.cmds[i], self.tags[i]):
                        w.show()
                        ctx = w.get_style_context()
                        if i == self.sel:
                            ctx.add_class("sel")
                        else:
                            ctx.remove_class("sel")
                else:
                    for w in (self.labels[i], self.cmds[i], self.tags[i]):
                        w.hide()

            if self.rows:
                e = self.rows[self.sel]
                # The cached answer only. Resolving a mode costs an ldd, and
                # paying that on every arrow keypress would put visible lag on
                # the one interaction that has to feel instant -- so something
                # never run before reads "auto" until the first time it is.
                mode = e.mode or _mode_cache.get(e.cmd) or "auto"
                self.hint.set_text("enter run  ·  ctrl+enter keep the window open"
                                   "  ·  arrows move  ·  esc close      [%s]"
                                   % mode)
            else:
                self.hint.set_text("nothing matches")
            self.win.resize(WIN_W, 1)

        # -- show / hide -------------------------------------------------

        def show(self, initial=""):
            if self.win.get_visible():
                self.hide()
                return
            self.index.maybe_reload()
            self.query = initial
            self.sel = 0
            self.refresh()

            # Never hardcode an output name (CLAUDE.md); ask X where the
            # pointer actually is and use that monitor.
            display = Gdk.Display.get_default()
            seat = display.get_default_seat()
            screen, px, py = seat.get_pointer().get_position()
            mon = display.get_monitor_at_point(px, py)
            geo = mon.get_geometry() if mon else None

            self.win.show_all()
            w, h = self.win.get_size()
            if geo:
                x = geo.x + (geo.width - w) // 2
                y = geo.y + int(geo.height * 0.22)
            else:
                x, y = px - w // 2, py
            self.win.move(x, y)
            self.refresh()

            # A grab, deliberately not focus -- and every capability, not just
            # the keyboard. A keyboard-only grab leaves the pointer free, so a
            # click hands focus elsewhere while this popup goes on swallowing
            # every keystroke on the desktop, which is indistinguishable from
            # the machine locking up and is only curable by killing it.
            #
            # owner_events MUST be False. With True, X delivers keys to the
            # window that would normally have received them -- the one still
            # focused underneath -- and this popup never sees a keystroke while
            # holding a perfectly good grab.
            #
            # Retry rather than believing the first refusal: the hotkey that
            # launched us is a passive XGrabKey in bbkeys, which X promotes to
            # an active grab the moment the combo matches and holds until every
            # modifier comes back up. A resident daemon maps its window far
            # faster than a finger leaves the Win key, so attempt one reliably
            # returns ALREADY_GRABBED. Run the same command from a shell, where
            # no modifier is down, and it succeeds first try -- which is the
            # trap, because it reads as "the keybinding is broken".
            #
            # monotonic, not time(): the wall clock can step under NTP, and a
            # timeout measured on it can expire instantly or never.
            deadline = time.monotonic() + GRAB_TIMEOUT
            tries = 0
            while True:
                tries += 1
                st = seat.grab(self.win.get_window(), Gdk.SeatCapabilities.ALL,
                               False, None, None, None, None)
                if st == Gdk.GrabStatus.SUCCESS or time.monotonic() >= deadline:
                    break
                time.sleep(GRAB_RETRY)
            self.grabbed = (st == Gdk.GrabStatus.SUCCESS)
            if not self.grabbed:
                # Never sit there ungrabbed-but-visible: with no input we
                # cannot be typed at and cannot be dismissed.
                log("grab failed (%s) after %d tries in %.2fs, closing"
                    % (st, tries, GRAB_TIMEOUT))
                self.hide()
                return
            if DEBUG:
                log("placed %dx%d at %d,%d grab=%s in %d tries"
                    % (w, h, x, y, st, tries))

        def hide(self):
            if self.grabbed:
                Gdk.Display.get_default().get_default_seat().ungrab()
                self.grabbed = False
            self.win.hide()
            Gdk.Display.get_default().sync()

        # -- keys --------------------------------------------------------

        def on_key(self, _w, ev):
            key = Gdk.keyval_name(ev.keyval)
            ctrl = bool(ev.state & Gdk.ModifierType.CONTROL_MASK)

            if key == "Escape":
                self.hide()
                return True
            if key in ("Return", "KP_Enter"):
                self.commit(hold=ctrl)
                return True
            if key == "BackSpace":
                self.query = self.query[:-1]
                self.sel = 0
                self.refresh()
                return True
            if ctrl and key == "u":
                self.query = ""
                self.sel = 0
                self.refresh()
                return True
            if ctrl and key == "w":
                q = self.query.rstrip()
                self.query = q[:q.rfind(" ") + 1] if " " in q else ""
                self.sel = 0
                self.refresh()
                return True
            if key == "Down" or (ctrl and key == "n") or key == "Tab":
                return self._step(1)
            if key == "Up" or (ctrl and key == "p") or key == "ISO_Left_Tab":
                return self._step(-1)

            ch = Gdk.keyval_to_unicode(ev.keyval)
            if ch and not ctrl:
                c = chr(ch)
                if c.isprintable():
                    self.query += c
                    self.sel = 0
                    self.refresh()
            return True

        def _step(self, d):
            if self.rows:
                self.sel = (self.sel + d) % len(self.rows)
                self.refresh()
            return True

        # -- mouse -------------------------------------------------------

        def _row_at(self, x, y):
            for i, lab in enumerate(self.labels):
                if i >= len(self.rows):
                    break
                a = lab.get_allocation()
                if a.y <= y < a.y + a.height:
                    return i
            return None

        def on_click(self, _w, ev):
            # A double click also emits 2BUTTON_PRESS, and we already committed
            # on the first press, so only ever act on the plain one.
            if ev.type != Gdk.EventType.BUTTON_PRESS:
                return True
            w, h = self.win.get_size()
            if not (0 <= ev.x < w and 0 <= ev.y < h):
                self.hide()      # clicked away -- the dismissal a keyboard-only
                return True      # grab could never have seen
            i = self._row_at(ev.x, ev.y)
            if i is None:
                return True
            self.sel = i
            self.commit(hold=bool(ev.state & Gdk.ModifierType.CONTROL_MASK))
            return True

        def on_scroll(self, _w, ev):
            if not self.rows:
                return True
            d = ev.direction
            if d == Gdk.ScrollDirection.UP:
                step = -1
            elif d == Gdk.ScrollDirection.DOWN:
                step = 1
            elif d == Gdk.ScrollDirection.SMOOTH:
                ok, _dx, dy = ev.get_scroll_deltas()
                if not ok or not dy:
                    return True
                step = 1 if dy > 0 else -1
            else:
                return True
            return self._step(step)

        def on_motion(self, _w, ev):
            # Only repaint when the highlight actually moves. Motion floods,
            # and with the pointer grabbed it keeps arriving off-window too.
            i = self._row_at(ev.x, ev.y)
            if i is not None and i != self.sel:
                self.sel = i
                self.refresh()
            return True

        # -- delivery ----------------------------------------------------

        def commit(self, hold=False):
            if not self.rows:
                self.hide()
                return
            entry = self.rows[self.sel]
            self.index.bump(entry.cmd)
            self.hide()
            # Hide first, launch after one turn of the loop: the window has no
            # business still being on screen while an app maps its own.
            GLib.timeout_add(20, self._launch, entry, hold)

        def _launch(self, entry, hold):
            try:
                where = launch(entry, hold)
                log("ran %r -> %s" % (entry.cmd, where))
            except Exception as e:                     # never take the daemon down
                log("launch failed for %r: %s" % (entry.cmd, e))
            return False

    popup = Popup(index)

    # Refuse to be the second daemon. Two instances both hold the fifo open for
    # reading, so each command goes to whichever reads first -- which looks like
    # the popup ignoring you at random, and makes any log you are reading belong
    # to the instance that didn't get the message.
    other = read_pidfile()
    if other and other != os.getpid():
        log("already running as pid %d; not starting a second one" % other)
        return 1

    # A previous crash can leave a plain file here -- a shell redirect into a
    # missing fifo path just creates one, and the next reader then blocks
    # forever on something that will never deliver. Check the mode, don't
    # assume, and note os.path.isfifo does not exist.
    try:
        try:
            st = os.stat(FIFO_PATH)
        except FileNotFoundError:
            st = None
        if st is not None and not stat.S_ISFIFO(st.st_mode):
            os.unlink(FIFO_PATH)
            st = None
        if st is None:
            os.mkfifo(FIFO_PATH, 0o600)
    except OSError as e:
        log("cannot create %s: %s" % (FIFO_PATH, e))
        return 1

    # O_RDWR so the daemon is its own writer and never sees EOF when a client
    # disconnects. Without it, every `commando` invocation would HUP the watch
    # and the daemon would answer exactly once.
    fd = os.open(FIFO_PATH, os.O_RDWR | os.O_NONBLOCK)

    def on_fifo(_src, _cond):
        try:
            data = os.read(fd, 4096).decode("utf-8", "replace")
        except OSError:
            return True
        for line in data.splitlines():
            line = line.strip()
            if not line:
                continue
            cmd, _, rest = line.partition(" ")
            if cmd == "show":
                popup.show(rest.strip())
            elif cmd == "hide":
                popup.hide()
            elif cmd == "quit":
                Gtk.main_quit()
        return True

    GLib.io_add_watch(fd, GLib.PRIORITY_DEFAULT, GLib.IOCondition.IN, on_fifo)

    try:
        with open(PID_PATH, "w") as fh:
            fh.write("%d\n" % os.getpid())
    except OSError:
        pass

    sweep_spool()
    GLib.timeout_add_seconds(600, sweep_spool)

    log("ready on %s" % FIFO_PATH)
    try:
        Gtk.main()
    except KeyboardInterrupt:
        pass
    finally:
        for path in (FIFO_PATH, PID_PATH):
            try:
                os.unlink(path)
            except OSError:
                pass
    return 0


if __name__ == "__main__":
    sys.exit(main())
