#!/usr/bin/env python3
#
# dotkeyd -- the dotkey daemon
#
# "win-key dot, but mangled a bit". a searchable unicode popup, bound to
# Mod4-Period, same as the windows emoji panel -- except it searches all
# 148k named codepoints by name instead of a curated emoji grid.
#
# WHY A DAEMON. measured on this box (1.6GHz Braswell Pentium, 2026-07-31):
#
#   import gi + Gtk 3.24 ......... 1.64 s     <- the entire problem
#   build the unicode index ...... 2.21 s
#   alacritty cold start ......... 0.61 s
#   xterm cold start ............. 0.19 s
#   bare python3 ................. 0.20 s
#   filter 148k names ............ 33-110 ms
#   empty query, the default view  0.1 ms   <- was 128 ms, see by_index
#
# so cold-starting anything gtk-shaped costs the better part of two seconds
# before a single pixel lands. rendering was never the problem; process
# startup was. a resident daemon pays all of it once at login and then just
# maps a prebuilt window, which is why this is a daemon and not a script.
#
# being a daemon only amortises *startup*, though. what's left is whatever
# each popup redoes, and the empty query is the one every popup runs -- it
# was rebuilding a 148k dict twice per open for the sake of ~10 lookups.
# that's 264ms nobody measured, because the timing table above only ever
# benchmarked the interesting query and never the default one.
#
# the window is Gtk.WindowType.POPUP, i.e. override-redirect -- "WM, don't
# manage me". that matters specifically because blackbox predates most
# _NET_WM_* hints, so anything negotiating with the WM is a gamble here.
# override-redirect sidesteps blackbox entirely: instant, undecorated, exact
# coordinates, no focus handshake.
#
# and because we never take focus -- we take a keyboard *grab* -- the window
# that had focus still has it. verified: focus stays on the target window the
# whole time the popup is up. so once we ungrab and unmap, whatever we send
# next lands where the user was already typing. no focus dance required.
#
# what we send is a PASTE, not the glyph itself. typing arbitrary unicode with
# xdotool means remapping a scratch keycode and restoring it immediately, and
# an app reading the event after the restore sees the wrong key -- measured
# here at 1 success in 8, the other 7 arriving as BackSpace. ctrl+v and
# ctrl+shift+v are ordinary mapped keys with no remap and no race, so dotkey
# puts the glyph on the clipboard and sends the chord the focused window
# actually understands. see TYPE_DELAY.
#
# astrid + claude
# 2026-07-31

import os
import sys
import math
import stat
import time
import json
import unicodedata

CACHE_DIR = os.path.expanduser("~/.cache/dotkey")
INDEX_PATH = os.path.join(CACHE_DIR, "index.tsv")
RECENT_PATH = os.path.join(CACHE_DIR, "recent.json")
CUSTOM_PATH = os.path.expanduser("~/.config/dotkey/custom.tsv")

RUNTIME_DIR = os.environ.get("XDG_RUNTIME_DIR") or "/run/user/%d" % os.getuid()
FIFO_PATH = os.path.join(RUNTIME_DIR, "dotkey.fifo")
# A pidfile, not a pgrep. `pgrep -f dotkeyd` also matches any shell whose own
# command line mentions dotkeyd -- including the one asking the question --
# so a "is it running?" check can kill the asker or answer yes about itself.
PID_PATH = os.path.join(RUNTIME_DIR, "dotkey.pid")

# The results are a grid of glyphs, not a list of named rows, because a list
# long enough to be useful is longer than anyone will read: the thing you
# wanted was rank 14 and you never saw it. Names don't fit in a cell, so the
# selected cell's name goes on its own line underneath -- one name, always the
# one you're looking at.
GRID_COLS = 9
GRID_ROWS = 7
MAX_HITS = GRID_COLS * GRID_ROWS   # results kept; also the ranking cutoff
CELL_W = 64
CELL_H = 46
# Fixed, so the popup never jumps sideways as the result count changes: the
# grid inside is centre-aligned and shrinks within it instead. show() centres
# the window once, and cannot re-centre on every keystroke without flicker.
WIN_W = GRID_COLS * CELL_W + 44
MAX_RECENT = 40        # how many picks we remember

# How long to keep asking for the input grab before giving up, and how often.
# We are launched from a hotkey, so the modifier that launched us is still
# down when we try to grab -- see the retry loop in show() for why that makes
# the first attempt fail. A second is far longer than anyone holds a key.
GRAB_TIMEOUT = 1.0
GRAB_RETRY = 0.01

# palette lifted from .config/alacritty/alacritty.toml so the popup looks like
# it belongs to this desktop rather than to gtk.
C_BG = "#010116"
C_FG = "#ffb1f3"
C_DIM = "#604070"
C_SEL = "#fc74f4"
C_ACCENT = "#69ffb0"
C_QUERY = "#ffff66"

UI_FONT = "Misc Tamsyn"

DEBUG = bool(os.environ.get("DOTKEY_DEBUG"))

# Paste is not one keystroke. ctrl+v in a terminal is the shell's literal-next,
# not a paste, so sending it there does nothing useful; and the xterm family
# pastes PRIMARY with shift+Insert rather than CLIPBOARD at all. Getting this
# wrong fails silently -- the glyph is on the clipboard, the window just never
# reads it -- so match on WM_CLASS and default to the GUI-app chord.
PASTE_CHORDS = {
    "Alacritty": "ctrl+shift+v",
    "kitty": "ctrl+shift+v",
    "Konsole": "ctrl+shift+v",
    "Gnome-terminal": "ctrl+shift+v",
    "Xfce4-terminal": "ctrl+shift+v",
    "Terminator": "ctrl+shift+v",
    "St": "ctrl+shift+v",
    "XTerm": "shift+Insert",
    "UXTerm": "shift+Insert",
    "URxvt": "shift+Insert",
}
DEFAULT_CHORD = "ctrl+v"

# Delay between synthetic keystrokes for --type. Typing an *unmapped* keysym
# makes xdotool temporarily remap a scratch keycode and restore it straight
# after, and an app that reads the event post-restore sees the wrong key.
# Measured here 2026-07-31: typing a lone U+2661 landed correctly in 1 run out
# of 8 -- the other 7 arrived as BackSpace. No delay value fixed it (20 and 60
# both dropped characters that 40 got through), so this path is best-effort
# and the clipboard is the default. Don't "fix" typing by tuning this number.
TYPE_DELAY = 40

# Names ending in a hex codepoint are algorithmic, not descriptive -- CJK
# ideographs and hangul syllables alone are ~130k of the 148k named
# codepoints. They stay searchable but must never outrank a real name, or
# every query drowns.
BULK_MARKERS = (
    "CJK UNIFIED IDEOGRAPH-",
    "CJK COMPATIBILITY IDEOGRAPH-",
    "HANGUL SYLLABLE ",
    "TANGUT IDEOGRAPH-",
    "TANGUT COMPONENT-",
    "NUSHU CHARACTER-",
    "KHITAN SMALL SCRIPT CHARACTER-",
    "EGYPTIAN HIEROGLYPH-",
    "VARIATION SELECTOR-",
    "PRIVATE USE",
)


# ---------------------------------------------------------------- the index

def read_pidfile():
    """PID of a live daemon, or None. Stale pidfiles are treated as absent."""
    try:
        with open(PID_PATH) as fh:
            pid = int(fh.read().strip())
    except (OSError, ValueError):
        return None
    try:
        os.kill(pid, 0)
    except OSError:
        return None
    return pid


def cp_label(ch):
    """U+XXXX for a single character, blank for a multi-char entry."""
    return "U+%04X" % ord(ch) if len(ch) == 1 else ""


def build_index():
    """Walk every codepoint and keep the ones unicodedata can name."""
    rows = []
    for cp in range(0x110000):
        ch = chr(cp)
        try:
            name = unicodedata.name(ch)
        except ValueError:
            continue
        rows.append((ch, name, ""))
    return rows


def load_custom():
    """Astrid's own glyphs: char <TAB> keywords.

    This is what retires bin/{heart,supson,endash,emdash,heartglyph} -- five
    scripts that each echoed one glyph into a lingering xclip. Custom rows are
    boosted above everything, so `heart` lands on the heart Astrid actually
    means rather than on SPARKLING HEART.
    """
    rows = []
    try:
        with open(CUSTOM_PATH, encoding="utf-8") as fh:
            for line in fh:
                line = line.rstrip("\n")
                if not line.strip() or line.lstrip().startswith("#"):
                    continue
                if "\t" not in line:
                    continue
                ch, kw = line.split("\t", 1)
                if not ch:
                    continue
                rows.append((ch, kw.strip().upper(), "custom"))
    except FileNotFoundError:
        pass
    return rows


def write_cache(rows):
    os.makedirs(CACHE_DIR, exist_ok=True)
    tmp = INDEX_PATH + ".tmp"
    with open(tmp, "w", encoding="utf-8") as fh:
        fh.write("#dotkey\t%s\n" % unicodedata.unidata_version)
        for ch, name, tag in rows:
            if tag == "custom":
                continue
            fh.write("%s\t%s\n" % (ch, name))
    os.replace(tmp, INDEX_PATH)


def read_cache():
    try:
        with open(INDEX_PATH, encoding="utf-8") as fh:
            head = fh.readline().rstrip("\n").split("\t")
            if len(head) != 2 or head[0] != "#dotkey":
                return None
            if head[1] != unicodedata.unidata_version:
                return None      # unicode got upgraded under us; rebuild
            rows = []
            for line in fh:
                line = line.rstrip("\n")
                tab = line.find("\t")
                if tab < 1:
                    continue
                rows.append((line[:tab], line[tab + 1:], ""))
            return rows or None
    except (FileNotFoundError, UnicodeDecodeError):
        return None


class Index:
    def __init__(self):
        t0 = time.time()
        rows = read_cache()
        cached = rows is not None
        if not cached:
            rows = build_index()
            write_cache(rows)
        rows = load_custom() + rows

        self.chars = [r[0] for r in rows]
        self.names = [r[1] for r in rows]
        self.lower = [n.lower() for n in self.names]
        self.custom = [r[2] == "custom" for r in rows]
        self.bulk = [n.startswith(BULK_MARKERS) for n in self.names]
        # Custom entries may be several characters long -- kaomoji are the
        # whole reason the custom set exists -- so nothing downstream may
        # assume ord() applies. Precompute both, once.
        self.cps = [ord(c) if len(c) == 1 else -1 for c in self.chars]
        self.labels = [cp_label(c) for c in self.chars]
        # char -> row index, for the handful of recents _default_rows looks up.
        # chars never changes after init, so this is built once here rather
        # than per call: rebuilding it cost 128ms on *every* empty query, i.e.
        # on every single popup, which was the entire visible open latency.
        self.by_index = {c: i for i, c in enumerate(self.chars)}
        # Same reasoning, same trap: _default_rows fills the grid from the
        # custom set, and scanning self.custom for it walks all 148k rows to
        # find ~30. That was invisible while the cutoff was 10 -- recents
        # alone reached it and the loop broke early -- and became 40ms on
        # every popup the moment the grid asked for more than the set can
        # supply. A derived list that never changes after init belongs here.
        self.custom_ix = [i for i, c in enumerate(self.custom) if c]

        self.recent = self._load_recent()
        # cache of the previous query, so typing narrows an existing result
        # set instead of rescanning 148k names on every keystroke
        self._last_q = None
        self._last_hits = None

        how = "cache" if cached else "built"
        sys.stderr.write("dotkeyd: %d glyphs (%s) in %.2fs\n"
                         % (len(self.chars), how, time.time() - t0))

    # -- recents ---------------------------------------------------------

    def _load_recent(self):
        try:
            with open(RECENT_PATH, encoding="utf-8") as fh:
                data = json.load(fh)
            return {k: float(v) for k, v in data.items()}
        except (FileNotFoundError, ValueError, AttributeError):
            return {}

    def bump(self, ch):
        self.recent[ch] = self.recent.get(ch, 0.0) + 1.0
        if len(self.recent) > MAX_RECENT:
            drop = sorted(self.recent, key=self.recent.get)[:-MAX_RECENT]
            for k in drop:
                del self.recent[k]
        try:
            os.makedirs(CACHE_DIR, exist_ok=True)
            tmp = RECENT_PATH + ".tmp"
            with open(tmp, "w", encoding="utf-8") as fh:
                json.dump(self.recent, fh)
            os.replace(tmp, RECENT_PATH)
        except OSError:
            pass

    # -- search ----------------------------------------------------------

    def _candidates(self, q):
        """Indices worth scoring for query q.

        If q merely extends the last query, every hit must be a subset of the
        last hit set -- substring matching is monotone that way. That turns
        the expensive first keystroke into a cheap fourth one.
        """
        if self._last_q and q.startswith(self._last_q) and self._last_hits is not None:
            return self._last_hits
        return range(len(self.chars))

    def search(self, q):
        q = q.strip().lower()
        if not q:
            self._last_q, self._last_hits = None, None
            return self._default_rows()

        # a bare codepoint -- "2661", "u+2661", "U2661" -- is an exact lookup
        direct = None
        hexq = q[2:] if q.startswith(("u+", "0x")) else (q[1:] if q.startswith("u") else q)
        if 2 <= len(hexq) <= 6 and all(c in "0123456789abcdef" for c in hexq):
            try:
                cp = int(hexq, 16)
                if 0 <= cp < 0x110000:
                    ch = chr(cp)
                    unicodedata.name(ch)     # raises if unnamed
                    direct = ch
            except (ValueError, OverflowError):
                pass

        # pasting the glyph itself should identify it
        if len(q) == 1 and ord(q) > 0x7F:
            direct = q

        toks = q.split()
        lower, bulk, custom, recent = self.lower, self.bulk, self.custom, self.recent
        hits = []
        scored = []
        for i in self._candidates(q):
            name = lower[i]
            total = 0
            ok = True
            for t in toks:
                pos = name.find(t)
                if pos < 0:
                    ok = False
                    break
                if name == t:
                    total += 0
                elif pos == 0:
                    total += 10
                elif name[pos - 1] == " " or name[pos - 1] == "-":
                    total += 20     # word-initial: "small alpha" for "alpha"
                else:
                    total += 40     # buried mid-word
            if not ok:
                continue
            hits.append(i)
            if bulk[i]:
                total += 10000
            if custom[i]:
                total -= 500
            total -= min(recent.get(self.chars[i], 0.0), 8.0) * 12
            total += len(name) * 0.01                 # prefer the tersest name
            total += max(self.cps[i], 0) * 1e-8       # prefer canonical codepoints
            scored.append((total, i))

        self._last_q, self._last_hits = q, hits

        # A pure-hex query is asking for one codepoint. Without this, "2661"
        # substring-matches CJK UNIFIED IDEOGRAPH-26610 and friends, and the
        # nine rows under the answer are pure noise.
        if direct is not None and hexq == q:
            scored = [s for s in scored if not self.bulk[s[1]]]

        scored.sort(key=lambda s: s[0])

        out = []
        seen = set()
        if direct is not None:
            out.append(self._describe(direct))
            seen.add(direct)
        for _, i in scored:
            ch = self.chars[i]
            if ch in seen:
                continue          # custom rows shadow their unicode twins
            seen.add(ch)
            out.append(self._row(i))
            if len(out) >= MAX_HITS:
                break
        return out

    def _row(self, i):
        return (self.chars[i], self.names[i], self.labels[i])

    def _describe(self, ch):
        try:
            name = unicodedata.name(ch) if len(ch) == 1 else "(custom)"
        except ValueError:
            name = "(unnamed)"
        return (ch, name, cp_label(ch))

    def _default_rows(self):
        """Empty query shows recents most-used first, then the custom set."""
        out = []
        seen = set()
        by_index = self.by_index
        for ch in sorted(self.recent, key=self.recent.get, reverse=True):
            if ch in seen:
                continue
            seen.add(ch)
            i = by_index.get(ch)
            out.append(self._row(i) if i is not None else self._describe(ch))
            if len(out) >= MAX_HITS:
                return out
        for i in self.custom_ix:
            if self.chars[i] in seen:
                continue
            seen.add(self.chars[i])
            out.append(self._row(i))
            if len(out) >= MAX_HITS:
                break
        return out


# ------------------------------------------------------------ headless CLI

def cli_search(index, query):
    rows = index.search(query)
    if not rows:
        print("(no matches)")
        return
    for ch, name, cp in rows:
        print("%-4s %-10s %s" % (ch, cp, name))


def main():
    args = sys.argv[1:]

    if args and args[0] in ("-h", "--help"):
        print(__doc__ or "dotkeyd -- see comments at the top of this file")
        print("usage: dotkeyd [--search QUERY | --rebuild | --bench]")
        return 0

    if args and args[0] == "--rebuild":
        rows = build_index()
        write_cache(rows)
        print("dotkey: rebuilt index, %d glyphs" % len(rows))
        return 0

    index = Index()

    if args and args[0] == "--search":
        cli_search(index, " ".join(args[1:]))
        return 0

    if args and args[0] == "--bench":
        for q in ("heart", "arrow", "greek small alpha", "smiling", "2661", "a"):
            t = time.time()
            rows = index.search(q)
            index._last_q = None      # measure cold, not narrowed
            print("%-20s %6.1f ms  -> %s"
                  % (q, (time.time() - t) * 1000,
                     " ".join(r[0] for r in rows[:6])))
        return 0

    return run_daemon(index)


# ------------------------------------------------------------------ the ui

def spiral_cells(cols, rows):
    """(col, row) for every cell, ordered outward from the centre.

    Rank 0 lands in the middle, where the eye already is, and each further
    result is one ring further out. Two things fall out of that for free.
    Ranking stays *legible* -- distance from the centre is the ranking, so a
    near-miss is visibly near -- and because the grid is a fixed size that
    fills from the middle, a short result list leaves whole outer rows and
    columns empty. GTK gives those zero size, so the block shrinks to fit
    while staying centred, with no repositioning of the window.

    Rings are measured in *pixels*, not cells, or a grid of non-square cells
    comes out elliptical; within a ring, clockwise from north.
    """
    cx, cy = cols // 2, rows // 2
    cells = [(c, r) for r in range(rows) for c in range(cols)]

    def key(cr):
        c, r = cr
        dx, dy = (c - cx) * CELL_W, (r - cy) * CELL_H
        return (round(math.hypot(dx, dy), 3),
                math.atan2(dx, -dy) % (2 * math.pi))

    return sorted(cells, key=key)


def run_daemon(index):
    import gi
    gi.require_version("Gtk", "3.0")
    from gi.repository import Gtk, Gdk, GLib, Pango

    import subprocess

    class Popup:
        def __init__(self, index):
            self.index = index
            self.query = ""
            self.rows = []
            self.sel = 0
            self.grabbed = False
            self._kids = []

            # POPUP is gtk's override-redirect window type. blackbox never
            # sees it, so there is nothing to negotiate with.
            self.win = Gtk.Window(type=Gtk.WindowType.POPUP)
            self.win.set_default_size(WIN_W, 0)
            self.win.set_app_paintable(True)

            frame = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
            frame.set_name("frame")
            self.win.add(frame)

            self.qlabel = Gtk.Label(xalign=0.0)
            self.qlabel.set_name("query")
            self.qlabel.set_ellipsize(Pango.EllipsizeMode.END)
            frame.pack_start(self.qlabel, False, False, 0)

            self.grid = Gtk.Grid()
            self.grid.set_halign(Gtk.Align.CENTER)
            frame.pack_start(self.grid, False, False, 0)

            # Preallocate every cell. Rebuilding widgets on every keystroke is
            # the one thing that would make this feel slow on this CPU -- and
            # re-*attaching* them is just as bad, so a cell's position is
            # fixed for the life of the daemon. Only its text and visibility
            # change. self.cells[k] is the cell holding rank k; self.at maps
            # the other way, which is what 2D arrow-key movement needs.
            self.order = spiral_cells(GRID_COLS, GRID_ROWS)
            self.at = {cr: k for k, cr in enumerate(self.order)}
            self.cells = []
            for c, r in self.order:
                cell = Gtk.Label(xalign=0.5)
                cell.set_name("cell")
                cell.set_size_request(CELL_W, CELL_H)
                # A cell is one column wide whatever is in it. Custom entries
                # can be whole words or kaomoji, and without this one of them
                # widens its entire column, shoves the grid past the window
                # and silently clips the far edge off the screen. The full
                # text is on the detail line, so truncating here loses
                # nothing.
                cell.set_ellipsize(Pango.EllipsizeMode.END)
                cell.set_max_width_chars(1)
                self.grid.attach(cell, c, r, 1, 1)
                self.cells.append(cell)

            # One name, for the cell you are actually on. 63 of them would not
            # fit and would not be read.
            self.detail = Gtk.Label(xalign=0.5)
            self.detail.set_name("detail")
            self.detail.set_ellipsize(Pango.EllipsizeMode.END)
            frame.pack_start(self.detail, False, False, 0)

            self.hint = Gtk.Label(xalign=0.0)
            self.hint.set_name("hint")
            frame.pack_start(self.hint, False, False, 0)

            self._style()
            self.win.connect("key-press-event", self.on_key)

            # Mouse. The grab below is owner_events=False, which means X
            # reports every pointer event to the *grab window* -- this
            # toplevel -- and never to a child. So per-row Gtk.EventBoxes
            # would never fire, and hit-testing here against each row's
            # allocation is the approach that actually works. It also gets
            # click-outside for free: those events arrive too, with
            # coordinates outside the window, which is the only way the
            # popup can learn it should dismiss.
            self.win.add_events(Gdk.EventMask.BUTTON_PRESS_MASK
                                | Gdk.EventMask.SCROLL_MASK
                                | Gdk.EventMask.POINTER_MOTION_MASK)
            self.win.connect("button-press-event", self.on_click)
            self.win.connect("scroll-event", self.on_scroll)
            self.win.connect("motion-notify-event", self.on_motion)

        def _style(self):
            css = """
            #frame  { background-color: %(bg)s;
                      border: 1px solid %(sel)s; }
            #query  { color: %(q)s; font-family: "%(font)s"; font-size: 15px;
                      padding: 8px 10px 8px 10px; }
            #cell   { color: %(fg)s; font-size: 25px; }
            /* a word or a kaomoji, not a glyph -- shrink it so more of it
               survives the one-column budget before ellipsis takes over */
            #cell.multi { font-family: "%(font)s"; font-size: 11px; }
            #cell.sel { background-color: %(dim)s; color: %(acc)s; }
            #detail { color: %(fg)s; font-family: "%(font)s"; font-size: 12px;
                      padding: 8px 10px 2px 10px; }
            #hint   { color: %(dim)s; font-family: "%(font)s"; font-size: 10px;
                      padding: 6px 10px 6px 10px; }
            """ % dict(bg=C_BG, fg=C_FG, dim=C_DIM, sel=C_SEL,
                       acc=C_ACCENT, q=C_QUERY, font=UI_FONT)
            prov = Gtk.CssProvider()
            prov.load_from_data(css.encode())
            Gtk.StyleContext.add_provider_for_screen(
                Gdk.Screen.get_default(), prov,
                Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

        # -- painting ----------------------------------------------------

        def refresh(self):
            self.rows = self.index.search(self.query)
            if self.sel >= len(self.rows):
                self.sel = max(0, len(self.rows) - 1)

            cursor = "█"
            self.qlabel.set_text("." + self.query + cursor)

            for k, cell in enumerate(self.cells):
                if k < len(self.rows):
                    ch = self.rows[k][0]
                    cell.set_text(ch)
                    cell.show()
                    ctx = cell.get_style_context()
                    if k == self.sel:
                        ctx.add_class("sel")
                    else:
                        ctx.remove_class("sel")
                    if len(ch) > 1:
                        ctx.add_class("multi")
                    else:
                        ctx.remove_class("multi")
                else:
                    cell.hide()

            if self.rows:
                ch, nm, code = self.rows[self.sel]
                nm = nm.title() if nm.isupper() else nm
                # Lead with the glyph itself when it is more than one
                # character: that is exactly the case where the cell had to
                # truncate it, so this is the only place it can be read whole.
                self.detail.set_text("%s   %s" % (code, nm) if code
                                     else "%s   %s" % (ch, nm))
                self.hint.set_text("enter paste  ·  ctrl+enter copy only  "
                                   "·  arrows move  ·  esc close")
            else:
                self.detail.set_text("")
                self.hint.set_text("no matches")
            self.win.resize(WIN_W, 1)

        # -- show / hide -------------------------------------------------

        def show(self, initial=""):
            if self.win.get_visible():
                self.hide()
                return
            self.query = initial
            self.sel = 0
            self.index._last_q = None
            self.refresh()

            # Never hardcode an output name (CLAUDE.md); ask X where the
            # pointer actually is and use that monitor.
            display = Gdk.Display.get_default()
            seat = display.get_default_seat()
            ptr = seat.get_pointer()
            screen, px, py = ptr.get_position()
            mon = display.get_monitor_at_point(px, py)
            geo = mon.get_geometry() if mon else None

            self.win.show_all()
            w, h = self.win.get_size()
            if DEBUG:
                sys.stderr.write("dotkeyd: show_all -> size %dx%d\n" % (w, h))
            if geo:
                x = geo.x + (geo.width - w) // 2
                y = geo.y + int(geo.height * 0.22)
            else:
                x, y = px - w // 2, py
            self.win.move(x, y)
            self.refresh()

            # A grab, deliberately not focus. The window underneath keeps X
            # input focus, which is what lets xdotool type into it later.
            #
            # owner_events MUST be False. With True, X delivers key events to
            # whichever window would normally have received them -- i.e. the
            # still-focused window underneath -- and this popup never sees a
            # keystroke while appearing to hold a perfectly good grab. False
            # routes every key to the grab holder, which is the entire point.
            # ALL, not KEYBOARD. A keyboard-only grab leaves the pointer
            # free, so a click hands focus to another window while this popup
            # goes on silently swallowing every keystroke on the desktop --
            # indistinguishable from the whole machine locking up, and only
            # killable. Grabbing the pointer too means clicks arrive here and
            # can dismiss us. It also pins the paste target: focus-follows-
            # mouse would otherwise let a stray pointer move retarget the
            # paste between opening the popup and picking a glyph.
            #
            # Retry rather than believing the first refusal. The hotkey that
            # launched us is a passive XGrabKey in bbkeys, and X promotes that
            # to an *active* grab the instant the combo matches, held until
            # every modifier comes back up. A resident daemon maps this window
            # in milliseconds -- far faster than a finger leaves the Win key --
            # so attempt one reliably returns ALREADY_GRABBED. Run the same
            # command from a shell, where no modifier is down, and it succeeds
            # first try. That asymmetry is the trap: it reads as "the keybind
            # is broken" when the keybind is the only part that works.
            # monotonic, not time(): the wall clock on this box steps around,
            # and a backwards step would leave this loop spinning long past
            # its deadline while a forwards one would abandon the grab on the
            # first try. monotonic cannot step, which is the only property a
            # timeout actually needs.
            deadline = time.monotonic() + GRAB_TIMEOUT
            tries = 0
            while True:
                tries += 1
                st = seat.grab(self.win.get_window(),
                               Gdk.SeatCapabilities.ALL,
                               False, None, None, None, None)
                if st == Gdk.GrabStatus.SUCCESS or time.monotonic() >= deadline:
                    break
                time.sleep(GRAB_RETRY)
            self.grabbed = (st == Gdk.GrabStatus.SUCCESS)
            if not self.grabbed:
                # Never sit there ungrabbed-but-visible, and never hold a
                # partial grab: without input we cannot be dismissed.
                sys.stderr.write("dotkeyd: grab failed (%s) after %d tries in "
                                 "%.2fs, closing\n"
                                 % (st, tries, GRAB_TIMEOUT))
                self.hide()
                return
            if DEBUG and tries > 1:
                sys.stderr.write("dotkeyd: grab took %d tries\n" % tries)
            if DEBUG:
                sys.stderr.write("dotkeyd: placed %dx%d at %d,%d grab=%s\n"
                                 % (self.win.get_size()[0], self.win.get_size()[1],
                                    x, y, st))

        def hide(self):
            if self.grabbed:
                Gdk.Display.get_default().get_default_seat().ungrab()
                self.grabbed = False
            self.win.hide()
            Gdk.Display.get_default().sync()

        # -- keys --------------------------------------------------------

        def on_key(self, _w, ev):
            key = Gdk.keyval_name(ev.keyval)
            if DEBUG:
                sys.stderr.write("dotkeyd: key %s\n" % key)
            ctrl = bool(ev.state & Gdk.ModifierType.CONTROL_MASK)

            if key == "Escape":
                self.hide()
                return True
            if key in ("Return", "KP_Enter"):
                shift = bool(ev.state & Gdk.ModifierType.SHIFT_MASK)
                self.commit("type" if shift else "copy" if ctrl else "paste")
                return True
            if key == "BackSpace":
                self.query = self.query[:-1]
                self.sel = 0
                self.refresh()
                return True
            if ctrl and key == "u":
                self.query = ""
                self.sel = 0
                self.refresh()
                return True
            if ctrl and key == "w":
                self.query = self.query.rstrip()
                self.query = self.query[:self.query.rfind(" ") + 1] \
                    if " " in self.query else ""
                self.sel = 0
                self.refresh()
                return True
            # Arrows move through the grid, Tab walks the ranking. Both are
            # wanted: the layout is spatial, but "next best match" is still a
            # question worth asking, and after a spiral placement the answer
            # is not in any one direction.
            if key == "Down":
                return self._move(0, 1)
            if key == "Up":
                return self._move(0, -1)
            if key == "Right":
                return self._move(1, 0)
            if key == "Left":
                return self._move(-1, 0)
            if key == "Tab" or (ctrl and key == "n"):
                return self._step(1)
            if key == "ISO_Left_Tab" or (ctrl and key == "p"):
                return self._step(-1)

            ch = Gdk.keyval_to_unicode(ev.keyval)
            if ch and not ctrl:
                c = chr(ch)
                if c.isprintable():
                    self.query += c
                    self.sel = 0
                    self.refresh()
            return True

        # -- mouse -------------------------------------------------------

        def _step(self, d):
            """Move in ranking order -- next or previous best match."""
            if self.rows:
                self.sel = (self.sel + d) % len(self.rows)
                self.refresh()
            return True

        def _move(self, dc, dr):
            """Move one cell in a direction, skipping empties and wrapping.

            Empty cells must be skipped rather than landed on: a partly filled
            grid is a disc, so the corners of its bounding box hold nothing
            and a plain step would select a cell that isn't there.
            """
            if not self.rows:
                return True
            c, r = self.order[self.sel]
            for _ in range(max(GRID_COLS, GRID_ROWS)):
                c, r = (c + dc) % GRID_COLS, (r + dr) % GRID_ROWS
                k = self.at.get((c, r))
                if k is not None and k < len(self.rows):
                    self.sel = k
                    self.refresh()
                    return True
            return True

        def _cell_at(self, x, y):
            """Which visible cell is under (x, y), in toplevel coordinates."""
            for k, cell in enumerate(self.cells):
                if k >= len(self.rows):
                    break        # cells fill in spiral order, so this is the end
                a = cell.get_allocation()
                if a.x <= x < a.x + a.width and a.y <= y < a.y + a.height:
                    return k
            return None

        def on_click(self, _w, ev):
            # A double click also emits 2BUTTON_PRESS; we already committed on
            # the first press, so only ever act on the plain one.
            if ev.type != Gdk.EventType.BUTTON_PRESS:
                return True
            w, h = self.win.get_size()
            if not (0 <= ev.x < w and 0 <= ev.y < h):
                self.hide()          # clicked away -- the dismissal that the
                return True          # keyboard-only grab could never see
            i = self._cell_at(ev.x, ev.y)
            if i is None:
                return True          # a click on the query line or the hint
            self.sel = i
            ctrl = bool(ev.state & Gdk.ModifierType.CONTROL_MASK)
            shift = bool(ev.state & Gdk.ModifierType.SHIFT_MASK)
            if ev.button == 3:
                mode = "copy"        # right click copies without pasting
            else:
                mode = "type" if shift else "copy" if ctrl else "paste"
            self.commit(mode)
            return True

        def on_scroll(self, _w, ev):
            if not self.rows:
                return True
            d = ev.direction
            if d == Gdk.ScrollDirection.UP:
                step = -1
            elif d == Gdk.ScrollDirection.DOWN:
                step = 1
            elif d == Gdk.ScrollDirection.SMOOTH:
                ok, _dx, dy = ev.get_scroll_deltas()
                if not ok or not dy:
                    return True
                step = 1 if dy > 0 else -1
            else:
                return True
            self.sel = (self.sel + step) % len(self.rows)
            self.refresh()
            return True

        def on_motion(self, _w, ev):
            # Only repaint when the highlight actually moves. Motion floods,
            # and with the pointer grabbed it keeps arriving off-window too.
            i = self._cell_at(ev.x, ev.y)
            if i is not None and i != self.sel:
                self.sel = i
                self.refresh()
            return True

        # -- delivery ----------------------------------------------------

        def commit(self, mode="paste"):
            if not self.rows:
                self.hide()
                return
            glyph = self.rows[self.sel][0]
            self.index.bump(glyph)
            self.hide()
            # The ungrab has to actually land before any XTEST event is sent,
            # or our own grab swallows it. One turn of the loop is enough.
            GLib.timeout_add(40, self._deliver, glyph, mode)

        def _reap(self):
            self._kids = [p for p in getattr(self, "_kids", []) if p.poll() is None]

        def _deliver(self, glyph, mode):
            self._reap()
            try:
                if mode == "type":
                    # Best effort only, and genuinely unreliable here -- see
                    # the note above TYPE_DELAY. Kept because some apps take
                    # no paste chord at all.
                    self._kids.append(subprocess.Popen(
                        ["xdotool", "type", "--clearmodifiers",
                         "--delay", str(TYPE_DELAY), "--", glyph]))
                    return False

                # Clipboard is the reliable path. xclip must stay resident:
                # X11 has no clipboard storage, the owning process serves the
                # data on request, so exiting would drop the selection.
                #
                # Both selections, deliberately. CLIPBOARD is what ctrl+v and
                # ctrl+shift+v read; PRIMARY is what shift+Insert and a middle
                # click read. Owning both means the glyph pastes by any route
                # the focused app happens to offer.
                for sel in ("clipboard", "primary"):
                    p = subprocess.Popen(["xclip", "-i", "-selection", sel],
                                         stdin=subprocess.PIPE)
                    p.stdin.write(glyph.encode("utf-8"))
                    p.stdin.close()
                    self._kids.append(p)

                if mode == "paste":
                    # Let xclip actually take ownership before asking anyone
                    # to read the selection back.
                    GLib.timeout_add(120, self._paste)
            except OSError as e:
                sys.stderr.write("dotkeyd: deliver failed: %s\n" % e)
            return False

        def _paste(self):
            """Send the paste chord the focused window actually understands.

            This is why pasting beats typing: ctrl+v and ctrl+shift+v are
            ordinary mapped keys, so no keymap remapping happens and there is
            no race to lose.
            """
            try:
                cls = subprocess.run(
                    ["xdotool", "getactivewindow", "getwindowclassname"],
                    capture_output=True, text=True, timeout=1).stdout.strip()
            except (OSError, subprocess.SubprocessError):
                cls = ""
            chord = PASTE_CHORDS.get(cls, DEFAULT_CHORD)
            if DEBUG:
                sys.stderr.write("dotkeyd: paste into %r with %s\n" % (cls, chord))
            try:
                self._kids.append(subprocess.Popen(
                    ["xdotool", "key", "--clearmodifiers", chord]))
            except OSError as e:
                sys.stderr.write("dotkeyd: paste failed: %s\n" % e)
            return False

    popup = Popup(index)

    # The FIFO is opened O_RDWR so the daemon is its own writer and therefore
    # never sees EOF when a client disconnects. Without that, every `dotkey`
    # invocation would HUP the watch and the daemon would answer exactly once.
    # Refuse to be the second daemon. Two instances both hold the fifo open
    # for reading, so each command goes to whichever happens to read first --
    # which looks like the popup ignoring you at random, and makes any log you
    # are reading belong to the instance that didn't get the message.
    other = read_pidfile()
    if other and other != os.getpid():
        sys.stderr.write("dotkeyd: already running as pid %d; not starting "
                         "a second one\n" % other)
        return 1

    # A previous crash can leave a plain file here -- a redirect into a missing
    # fifo path just creates one -- so check the mode, don't assume.
    try:
        try:
            st = os.stat(FIFO_PATH)
        except FileNotFoundError:
            st = None
        if st is not None and not stat.S_ISFIFO(st.st_mode):
            os.unlink(FIFO_PATH)
            st = None
        if st is None:
            os.mkfifo(FIFO_PATH, 0o600)
    except OSError as e:
        sys.stderr.write("dotkeyd: cannot create %s: %s\n" % (FIFO_PATH, e))
        return 1

    fd = os.open(FIFO_PATH, os.O_RDWR | os.O_NONBLOCK)

    def on_fifo(_src, _cond):
        try:
            data = os.read(fd, 4096).decode("utf-8", "replace")
        except OSError:
            return True
        for line in data.splitlines():
            line = line.strip()
            if not line:
                continue
            cmd, _, rest = line.partition(" ")
            if DEBUG:
                sys.stderr.write("dotkeyd: cmd %r\n" % line)
            if cmd == "show":
                popup.show(rest.strip())
            elif cmd == "hide":
                popup.hide()
            elif cmd == "quit":
                Gtk.main_quit()
        return True

    GLib.io_add_watch(fd, GLib.PRIORITY_DEFAULT, GLib.IOCondition.IN, on_fifo)

    try:
        with open(PID_PATH, "w") as fh:
            fh.write("%d\n" % os.getpid())
    except OSError:
        pass

    # Every paste leaves the *previous* pair of xclips defunct once they lose
    # the selection. _deliver reaps them, but only on the next paste, so a
    # daemon that runs for weeks would sit on zombies in between. Sweep them.
    GLib.timeout_add_seconds(30, lambda: (popup._reap(), True)[1])

    sys.stderr.write("dotkeyd: ready on %s\n" % FIFO_PATH)
    try:
        Gtk.main()
    except KeyboardInterrupt:
        pass
    finally:
        for path in (FIFO_PATH, PID_PATH):
            try:
                os.unlink(path)
            except OSError:
                pass
    return 0


if __name__ == "__main__":
    sys.exit(main())
