#!/bin/bash
#
# screenshot
#
# take a picture, it'll last longer
#
# 4strid
# 2019-11-17

ONE=0
DIR=$HOME/doc/screenshots

OPTIND=0
while getopts "1D:" OPT; do
  case $OPT in
  1)
    ONE=1
    ;;
  D)
    DIR="$OPTARG"
    ;;
  *)
    exit
    ;;
  esac
done

# after getopts, so that -D actually reaches it
FILE="${DIR}/`date +%F-%I.%M.%S-%P`.png"

[[ ! -d $DIR ]] && mkdir -p "$DIR"

if (( $ONE )); then
  xwd | magick xwd:- png:- > "$FILE"
else
  xwd -root -display :0 | magick xwd:- png:- > "$FILE"
fi
