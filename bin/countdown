#!/bin/bash
#
# countdown
#
# run a command, but not right this second. counts down at you in
# absurdly large numbers first, so you have time to go and focus the
# window you actually wanted a picture of.
#
#   countdown screenshot           # in five
#   countdown -t 10 'screenshot'   # in ten
#
# in a terminal it fills whatever terminal it is given. launched from a
# keybinding or the blackbox menu, where there is no terminal at all, it
# pops its own -- and closes it again *before* running the command, so the
# countdown is never in the screenshot.
#
# like `eventually`, but you can see it coming.
#
# astrid
# 2026-08-01

SECS=5
FILL='█'

# terminal cells are about twice as tall as they are wide, so the glyphs
# get stretched horizontally by this much to come out looking square.
ASPECT=2

# 0-9, seven rows each, six columns wide. '#' is ink, everything else is
# paper; the whole thing gets blown up by an integer scale at render time.
FONT=(
  ' #### ' '##  ##' '##  ##' '##  ##' '##  ##' '##  ##' ' #### '
  '  ##  ' ' ###  ' '  ##  ' '  ##  ' '  ##  ' '  ##  ' '######'
  ' #### ' '##  ##' '    ##' '   ## ' '  ##  ' ' ##   ' '######'
  ' #### ' '##  ##' '    ##' '  ### ' '    ##' '##  ##' ' #### '
  '##  ##' '##  ##' '##  ##' '######' '    ##' '    ##' '    ##'
  '######' '##    ' '##    ' '##### ' '    ##' '##  ##' ' #### '
  ' #### ' '##  ##' '##    ' '##### ' '##  ##' '##  ##' ' #### '
  '######' '    ##' '   ## ' '  ##  ' ' ##   ' ' ##   ' ' ##   '
  ' #### ' '##  ##' '##  ##' ' #### ' '##  ##' '##  ##' ' #### '
  ' #### ' '##  ##' '##  ##' ' #####' '    ##' '##  ##' ' #### '
)

usage () {
  cat <<EOF
usage: countdown [-t seconds] [-c char] [command ...]

  -t  how long to wait, in whole seconds (default $SECS)
  -c  the character to draw the numbers with (default $FILL)

the command is run through the shell, so pipes and semicolons are fine.
with no command it is just a very large egg timer.
EOF
}

OPTIND=0
while getopts "t:c:h" OPT; do
  case $OPT in
  t)
    SECS="$OPTARG"
    ;;
  c)
    FILL="$OPTARG"
    ;;
  h)
    usage
    exit 0
    ;;
  *)
    usage >&2
    exit 2
    ;;
  esac
done
shift $((OPTIND - 1))

CMD="$*"

if [[ ! $SECS =~ ^[0-9]+$ ]]; then
  echo "countdown: -t wants whole seconds, not '$SECS'" >&2
  exit 2
fi

TTY=0
[[ -t 1 ]] && TTY=1

# ---------------------------------------------------------------- no terminal

# Launched from a keybinding or a menu there is nowhere to draw, so go and
# get a window. The inner countdown only counts -- the command runs back
# here, after that window has closed, so it can't end up in the picture.
#
# Neither alacritty nor xterm passes its child's exit status back to us
# (measured: both return 0 regardless), so the inner one touches a marker
# file to say it finished. No marker means it was cancelled, and cancelling
# a countdown has to mean the command does not run.
if (( ! TTY )) && [[ -z $COUNTDOWN_INNER && -n $DISPLAY ]]; then
  SELF=$(readlink -f "$0")
  export COUNTDOWN_INNER=1
  export COUNTDOWN_DONE
  COUNTDOWN_DONE=$(mktemp -t countdown.XXXXXX)

  if command -v alacritty >/dev/null; then
    alacritty --config-file ~/.config/alacritty/countdown.toml \
      --title 'countdown' -e "$SELF" -t "$SECS" -c "$FILL"
  elif command -v xterm >/dev/null; then
    xterm -geometry 40x21 -title 'countdown' -e "$SELF" -t "$SECS" -c "$FILL"
  else
    sleep "$SECS"
    : > "$COUNTDOWN_DONE"
  fi

  if [[ -s $COUNTDOWN_DONE ]]; then
    rm -f "$COUNTDOWN_DONE"
    if [[ -n $CMD ]]; then
      eval "$CMD"
    fi
    exit
  fi

  rm -f "$COUNTDOWN_DONE"
  exit 130
fi

# ------------------------------------------------------------------ the show

restore () {
  (( TTY )) && printf '\033[?25h\033[?1049l'
}

if (( TTY )); then
  trap 'restore; exit 130' INT TERM
  trap restore EXIT
  printf '\033[?1049h\033[?25l'    # alternate screen, hide the cursor
fi

# draw one number as big as it will go in the terminal we have
render () {
  local NUM="$1"
  local COLS LINES NDIG W VS HS PADX PADY PAD INK PAPER ROW OUT COLOUR
  local D R C I

  COLS=$(tput cols)
  LINES=$(tput lines)
  NDIG=${#NUM}
  W=$((NDIG * 7 - 1))               # six columns per digit, one space between

  # biggest vertical scale that still fits both ways, remembering that each
  # step of it costs ASPECT columns and only one line
  VS=$(( (LINES - 2) / 7 ))
  C=$(( (COLS - 2) / (W * ASPECT) ))
  (( C < VS )) && VS=$C
  (( VS > 8 )) && VS=8
  (( VS < 1 )) && VS=1

  # ...and give up the squareness rather than wrap, in a very narrow one
  HS=$((VS * ASPECT))
  while (( W * HS > COLS && HS > 1 )); do
    HS=$((HS - 1))
  done

  PADX=$(( (COLS - W * HS) / 2 ))
  PADY=$(( (LINES - 7 * VS) / 2 ))
  (( PADX < 0 )) && PADX=0
  (( PADY < 0 )) && PADY=0

  printf -v PAD '%*s' "$PADX" ''
  printf -v PAPER '%*s' "$HS" ''    # one glyph cell of paper...
  INK=${PAPER// /$FILL}             # ...and one of ink

  # green while there is time, yellow when there isn't much, red at the end
  if (( NUM > 3 )); then
    COLOUR=32
  elif (( NUM > 1 )); then
    COLOUR=33
  else
    COLOUR=31
  fi

  printf '\033[H\033[2J\033[1;%dm' "$COLOUR"

  for (( I = 0; I < PADY; I++ )); do
    printf '\n'
  done

  for (( R = 0; R < 7; R++ )); do
    ROW=''
    for (( D = 0; D < NDIG; D++ )); do
      (( D )) && ROW+=' '
      ROW+="${FONT[${NUM:D:1} * 7 + R]}"
    done

    OUT=''
    for (( C = 0; C < ${#ROW}; C++ )); do
      if [[ ${ROW:C:1} == '#' ]]; then
        OUT+="$INK"
      else
        OUT+="$PAPER"
      fi
    done

    for (( I = 0; I < VS; I++ )); do
      printf '%s%s\n' "$PAD" "$OUT"
    done
  done

  printf '\033[0m'
}

N=$SECS
while (( N > 0 )); do
  if (( TTY )); then
    render "$N"
  else
    printf '%d ' "$N" >&2
  fi
  sleep 1
  N=$((N - 1))
done

if (( ! TTY && SECS )); then
  printf '\n' >&2
fi

# get our own artwork off the screen before anything takes a picture of it
restore
trap - EXIT INT TERM
TTY=0

# tell the outer copy, if there is one, that we got all the way to zero
if [[ -n $COUNTDOWN_DONE ]]; then
  echo done > "$COUNTDOWN_DONE"
fi

if [[ -n $CMD ]]; then
  eval "$CMD"
fi
