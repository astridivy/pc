#!/bin/bash
#
# meters
#
# 300,000,000 m/s
#
# astrid
# 2022-04-15
#
# as meters111, but at jack_meter's default 79-col width. see that file for
# the port and refresh-rate notes.

rate=${METER_RATE:-30}

xterm -geometry 115x3+1-29 -e jack_meter -f "$rate" "$@" &
xterm -geometry 115x3-65-2 -e jack_meter -f "$rate" "$@" &
