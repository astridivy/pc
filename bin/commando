#!/bin/bash
#
# commando -- poke the commando daemon
#
# "win-key /" for linux, bound to Mod4-slash in ~/.bbkeysrc. A searchable
# command runner: type, pick, and the thing lands as a new *screen window* in a
# session you already have open rather than as another terminal you have to
# close later. See bin/commandod for the whole design.
#
# This is deliberately a shell script and not python: bare python3 startup is
# 200ms on this box and gtk is 1.6s, which is exactly the cost commandod exists
# to amortise. Spending it again in the client would defeat the design. A write
# to a fifo is a few milliseconds.
#
#   commando            open the popup
#   commando htop       open it with a query already typed
#   commando --where    which screen session the next command would land in
#   commando --quit     stop the daemon
#   commando --restart  stop it and start it again (after editing ~/bin/shortcuts)
#
# astrid + claude
# 2026-08-07

set -u

RUN="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
FIFO="$RUN/commando.fifo"
PIDF="$RUN/commando.pid"
LOG="$RUN/commando.log"

# Ask the pidfile, never `pgrep -f commandod`: that pattern also matches the
# shell running this very script, since the string appears in its command line.
# pgrep then answers yes about itself and pkill shoots the asker.
daemon_running() {
  local pid
  [ -r "$PIDF" ] || return 1
  read -r pid < "$PIDF" 2>/dev/null || return 1
  [ -n "$pid" ] || return 1
  kill -0 "$pid" 2>/dev/null
}

stop_daemon() {
  local pid
  daemon_running || return 0
  read -r pid < "$PIDF"
  kill -TERM "$pid" 2>/dev/null
  for _ in $(seq 1 40); do daemon_running || return 0; sleep 0.05; done
  kill -KILL "$pid" 2>/dev/null
}

start_daemon() {
  # setsid so the daemon outlives the shell that spawned it -- bbkeys reaps its
  # children, and we want this one resident until X goes away.
  setsid commandod >>"$LOG" 2>&1 < /dev/null &
  for _ in $(seq 1 200); do
    [ -p "$FIFO" ] && return 0
    sleep 0.05
  done
  echo "commando: daemon did not come up; see $LOG" >&2
  return 1
}

case "${1:-}" in
  --quit)
    stop_daemon
    exit 0
    ;;
  --restart|--reload)
    stop_daemon
    rm -f "$FIFO"
    start_daemon || exit 1
    exit 0
    ;;
  # Straight through to the daemon's headless side. These need no popup, no
  # running daemon and no X, which is what makes them usable from a script or
  # over ssh -- and testable without putting a window on the live desktop.
  --where|--search|--mode)
    exec commandod "$@"
    ;;
  --help|-h)
    sed -n '3,20p' "$0" | sed 's/^# \{0,1\}//'
    exit 0
    ;;
esac

if ! daemon_running; then
  start_daemon || exit 1
fi

# A fifo with no reader would block forever, so never write blind: the daemon
# holds the read end open for as long as it lives, and we just checked.
if ! printf 'show %s\n' "${*:-}" > "$FIFO" 2>/dev/null; then
  echo "commando: could not reach the daemon on $FIFO" >&2
  exit 1
fi
