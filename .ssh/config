#
# ~/.ssh/config
#
# (pc/.ssh/config)
#

Host *
  # hand the passphrase over to ssh-agent the first time it's typed,
  # and let the agent remember it for a day before asking again
  # (agent itself: systemctl --user enable --now ssh-agent.socket,
  #  plus SSH_AUTH_SOCK out of bashrc/exports)
  AddKeysToAgent 24h
