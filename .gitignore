doc/download

# AUR build checkout: 141M of tarballs, pkg/, src/ and its own .git
yay/yay/

# .claude/ and .codex/ are deny-by-default for the same reason .ssh/ is: this
# repo is $HOME, and both dirs keep live credentials (.claude/.credentials.json,
# .codex/auth.json) beside the settings, plus history, sessions and sqlite
# state. only the settings travel; add new entries deliberately.
# no .codex/rules: codex runs in yolo mode, so prefix rules never fire.
# > actually , while that is USUALLY what settings.local.json is for , ours DOES
# > happily travel along , so claude sessions in .pc happily work without work trees
# > on any computer ;>
# > ~ ♥ * AI ☯ ★ 💻!
.claude/*
!.claude/CLAUDE.md
!.claude/settings.json
!.claude/settings.local.json
!.claude/themes/
.codex/*
!.codex/config.toml
!.codex/AGENTS.md

# .ssh/ is deny-by-default: this repo is $HOME, so a key copied in here
# would be one `git add .` away from being published. config is the only
# file that belongs; add new entries deliberately, never the whole dir.
.ssh/*
!.ssh/config

# python leaves these next to any script in bin/
__pycache__/

bell/.sequence

.config/commando/hidden.txt
.config/commando/favorite.tsv
.config/commando/terminals.tsv
