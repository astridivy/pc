doc/download

# AUR build checkout: 141M of tarballs, pkg/, src/ and its own .git
yay/yay/

# Claude Code project settings
.claude/

# .ssh/ is deny-by-default: this repo is $HOME, so a key copied in here
# would be one `git add .` away from being published. config is the only
# file that belongs; add new entries deliberately, never the whole dir.
.ssh/*
!.ssh/config
