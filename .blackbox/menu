# blackbox menu, configured with style by bbconf

[begin] (astrid@ivy)
  [exec] (# Files) {thunar}
  [exec] ($ Shell) { alacritty --config-file ~/.config/alacritty/tall.toml }
  [exec] (@ Itrnet) {google-chrome-stable}
  [exec] (::ai@venusaur) { alacritty --title "ssh : [ai@venusaur] $ " --config-file ~/.config/alacritty/nearly.toml -e ssh ai@astrid.computer }
  [exec] (% Take Screenshot) { screenshot}
  [exec] (% Arm Screenshot) { screenshot -1}
  [submenu] ({AI}) { my lil buddies }
    [exec] (Claude) { claude-desktop }
    [exec] (Claude-code) { cclod }
    [exec] (ChatGPT) { google-chrome-stable "https://chatgpt.com" }
    [exec] (Ivy) { alacritty --config-file ~/.config/alacritty/nearly.toml --title "IVY >:)" -e screen IVY_BASE="/home/astrid/chats/the-chat" node /née/ivy.js }
  [end]
  [submenu] ({*}) {everything that used to be out here}
    [workspaces] ([+] Spaces)
    [submenu] ([Terminal]) {C-L-I love the terminal}
      [exec] (Vim) { vvim }
      [exec] (Musikcube) { alacritty --title "music kube" -e musikcube}
      [exec] (Clock) { clock }
      [exec] (Tap Tempo) { watempo }
      [exec] (Volume Mixer) { volumectl }
    [end]
    [submenu] ([Monitor]) {beep boop computer !}
      [exec] (batt) { watbat }
      [exec] (sensors) { watsen }
      [exec] (jack meters) { meters }
      [exec] (top) { alacritty --config-file ~/.config/alacritty/xlarge.toml --title "top - system monitor" -e top }
      #[exec] (Disable Laptop Monitor) { xterm -e 'xrandr --output LVDS-1 --off'}
    [end]
    [submenu] ([Connect to]) {SSH || wifi}
      [exec] (Venusaur) { alacritty --title "ssh : [ai@venusaur] $ " --config-file ~/.config/alacritty/nearly.toml -e ssh ai@astrid.computer }
      [exec] (Peace+Love) {xterm -e "nmcli con up wifi"}
      [exec] (Wind0ze) { alacritty --title "wind0ze" -e cd ~/.wine/drive_c }
    [end]
    [submenu] ([Gaming]) {make play gaem}
      [exec] (Minecraft >=1.17) { xterm -e "MESA_GL_VERSION_OVERRIDE=4.3 minecraft-launcher" }
      [exec] (Discord) { discord}
      [exec] (Steam) { steam }
      [exec] (Tetris) { xterm -e vitetris}
      [exec] (Obs Studio) { obs }
      #[exec] (RGB Keyboard LEDs) { keyledsd }
    [end]
    [submenu] ([Audio]) {make play mueseic}
      [exec] (Ardour 9) { ardour9 }
      [exec] (QJackctl) { qjackctl }
      [exec] (Calf FX) { calfjackhost}
      [exec] (CLI Meters) { meters111 }
      [exec] (All of the Above) { maeusic }
      [exec] (Volume Control) { pavucontrol}
      [submenu] (<Etc>) {whatev er}
        [exec] (Labs) { /mnt/datao/music/LABS-CARLA.sh }
        [exec] (Carla-Rack) {carla-rack}
        [exec] (Hydrogen) { hydrogen}
        [exec] (Audacity) { audacity}
        [exec] (Carla) { carla}
        [exec] (LMMS) { lmms}
        [exec] (taptempo) { watempo }
        [exec] (Output Meter) { cadence-jackmeter }
        [exec] (Input Meter) { cadence-jackmeter -in }
        [exec] (Reset Pulse Shi*) { pajack }
      [end]
    [end]
    [submenu] ([System]) { Bleep bloop computer}
      [exec] (Sleep) { systemctl suspend}
      [exec] (Shut Down) { shutdown now}
      [exec] (Restart) { shutdown now -r}
      [exec] (Screenshot) { screenshot}
      [exec] (Screenshot An App) { screenshot -1}
      [exec] (Screenshot after Count) { countdown screenshot}
      [exec] (Terminate An App) { xdotool  selectwindow  windowkill }
    [end]
    [submenu] ([Blackbox]) {window mamnager}
      [exec] (Sensible Defaults) {default}
      [exec] (Configurator) {bbconf}
      [submenu] (Dockapps) { widjets}
        [exec] (Enable) { dockapps}
        [exec] (Cull) { dockapps kill}
      [end]
      [submenu] (Styles) {}
        [stylesdir] (/usr/share/blackbox/styles)
      [end]
      [config] (Configuration)
      [exec] (edit blackbox menu) { vvim ~/.blackbox/menu}
      [exec] (Edit Hotkeys) { vvim ~/.bbkeysrc}
      [exec] (Redraw Desktop) {feh --bg-center $HOME/doc/galaxy.jpg}
      [restart] (Restart Blackbox) {}
      [exit] (Exit Blackbox)
    [end]
  [end]
  [exec] (~/.blackbox/menu) { vvim ~/.blackbox/menu}
  [exec] (Restart) { shutdown now -r}
[end]
